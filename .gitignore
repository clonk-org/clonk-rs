# Build directories
build/
bin/
out/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
_deps/
*.cmake
!cmake/*.cmake
!autobuild/*.cmake

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE settings
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Debug files and backups
*.dSYM/
*.su
*.idb
*.pdb
*.bak
*.orig
*.rej
*.patch
# Unix core dumps land at the working-directory root and are named `core` or
# `core.<pid>`. Anchoring and digit-matching keeps the rule from swallowing
# Rust modules named `core` (an unanchored `core.*` silently excluded
# crates/clonk-engine/src/scenario/core.rs from its own split commit).
/core
core.[0-9]*

# Generated dependencies
*.d
.deps/
.libs/

# Generated documentation
docs/generated/

# Game specific files that should be ignored if generated
*.c4p
*.c4d
*.c4f
*.c4s
*.c4m
Clonk.log

# Rust build artifacts
target/

# Python test artifacts
__pycache__/
*.py[cod]

# Game data files and directories
*.c4p
*.c4d
*.c4f
*.c4s
*.c4m
*.c4g

# Authorized classic add-on packs live in the install-root namespace.
!/EkeReloaded.c4d/
!/EkeReloaded.c4d/**
!/EkeReloaded.c4f/
!/EkeReloaded.c4f/**
!/ClonkMars.c4d/
!/ClonkMars.c4d/**
!/ClonkMars.c4f/
!/ClonkMars.c4f/**

# But track specific source files and assets in planet/
!planet/Graphics.c4g/
!planet/System.c4g/
planet/Graphics.c4g/*
planet/System.c4g/*

# Graphics assets to track
!planet/Graphics.c4g/*.png
!planet/Graphics.c4g/*.jpg
!planet/Graphics.c4g/COPYING
!planet/Graphics.c4g/Version.txt
!planet/Graphics.c4g/C4.PAL

# System files to track
!planet/System.c4g/*.c
!planet/System.c4g/*.txt
!planet/System.c4g/*.ttf
!planet/System.c4g/COPYING
/planet/Extra.c4g/

# Staging for the shadow-diff harness: the pinned oracle hardcodes its Rust
# include path to <source>/rust/include, and parity/bridge/build-oracle-validation.sh
# points that at this checkout, so the header has to be reachable here too.
/include/
