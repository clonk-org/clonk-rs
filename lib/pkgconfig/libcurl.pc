###########################################################################

prefix=/Users/runner/work/deps/deps/output
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="HTTP HTTPS WS WSS"
supported_features="alt-svc AsynchDNS HSTS HTTPS-proxy IDN IPv6 Largefile libz NTLM SSL threadsafe TLS-SRP UnixSockets"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
Version: 8.16.0
Requires: openssl,zlib
Requires.private: openssl,zlib
Libs: -L${libdir} -lcurl -lssl -lcrypto -lz -licucore -liconv
Libs.private: -framework SystemConfiguration -framework CoreFoundation -framework CoreServices -lssl -lcrypto -lz -licucore -liconv
Cflags: -I${includedir} -DCURL_STATICLIB
Cflags.private: -DCURL_STATICLIB
