#!/bin/sh
set -eu

rustc_bin=${RUSTC:-rustc}
sysroot=$("$rustc_bin" --print sysroot)
linker="$sysroot/lib/rustlib/aarch64-apple-darwin/bin/gcc-ld/ld64.lld"

if [ ! -x "$linker" ]; then
    echo "toolchain Mach-O LLD is unavailable at $linker" >&2
    exit 1
fi

exec /usr/bin/clang "-fuse-ld=$linker" "$@"
