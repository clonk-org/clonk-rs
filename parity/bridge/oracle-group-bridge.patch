+namespace {
+// LC_RUST_GROUP_DEEP: beyond the entry list, read every file through both
+// engines, ask Rust whether every entry exists, and compare maker and root;
+// every buffer and string Rust hands over is freed here. LC_RUST_GROUP_FAULT=read
+// flips the first file comparison to prove the read report fires.
+void DeepCheck(C4Group &group, GroupHandle *handle, const std::vector<LegacyEntry> &legacy_entries, const char *full_name) {
+    const char *deep = std::getenv("LC_RUST_GROUP_DEEP");
+    if (!deep || !*deep) {
+        return;
+    }
+    const char *fault = std::getenv("LC_RUST_GROUP_FAULT");
+    bool fault_read = fault && std::string_view{fault} == "read";
+    std::vector<std::string> read_mismatches;
+    std::vector<std::string> exists_mismatches;
+    std::size_t files_read = 0;
+    for (const auto &entry : legacy_entries) {
+        if (!lc_group_exists(handle, entry.original.c_str())) {
+            exists_mismatches.push_back(entry.original);
+        }
+        if (entry.is_directory) {
+            continue;
+        }
+        StdBuf legacy;
+        if (!group.LoadEntry(entry.original.c_str(), legacy)) {
+            read_mismatches.push_back(entry.original + " (legacy load failed)");
+            continue;
+        }
+        std::size_t rust_len = 0;
+        unsigned char *rust = lc_group_read_file(handle, entry.original.c_str(), &rust_len);
+        if (!rust) {
+            read_mismatches.push_back(entry.original + " (rust read failed)");
+            continue;
+        }
+        bool same = rust_len == legacy.getSize() && (rust_len == 0 || std::memcmp(rust, legacy.getData(), rust_len) == 0);
+        if (fault_read) {
+            same = false;
+            fault_read = false;
+        }
+        if (!same) {
+            read_mismatches.push_back(entry.original);
+        }
+        lc_group_buffer_free(rust, rust_len);
+        ++files_read;
+    }
+    std::optional<std::string> rust_maker;
+    if (char *maker = lc_group_maker(handle)) {
+        rust_maker = maker;
+        lc_group_string_free(maker);
+    }
+    const std::string legacy_maker = group.GetMaker() ? group.GetMaker() : "";
+    std::string maker_report;
+    if (group.GetStatus() == GRPF_File) {
+        if (!rust_maker || *rust_maker != legacy_maker) {
+            maker_report = "maker mismatch (legacy='" + legacy_maker + "', rust='" + rust_maker.value_or("<none>") + "')";
+        }
+    } else if (rust_maker) {
+        // C4Group names an opened folder "Open directory"; Rust has no maker for it.
+        maker_report = "maker reported for a folder (rust='" + *rust_maker + "')";
+    }
+    std::optional<std::string> rust_root;
+    if (char *root = lc_group_root(handle)) {
+        rust_root = root;
+        lc_group_string_free(root);
+    }
+    std::string root_report;
+    if (!rust_root || Canonicalise(*rust_root) != Canonicalise(full_name)) {
+        root_report = "root mismatch (legacy='" + std::string(full_name) + "', rust='" + rust_root.value_or("<none>") + "')";
+    }
+#ifdef C4ENGINE
+    if (read_mismatches.empty() && exists_mismatches.empty() && maker_report.empty() && root_report.empty()) {
+        LogNTr(spdlog::level::info, "Rust group validation {}: deep check agrees ({} files read)", full_name, files_read);
+        return;
+    }
+    if (!read_mismatches.empty()) {
+        LogNTr(spdlog::level::warn, "Rust group validation {}: read mismatch for entries: {}", full_name, SummariseList(read_mismatches));
+    }
+    if (!exists_mismatches.empty()) {
+        LogNTr(spdlog::level::warn, "Rust group validation {}: exists false for entries: {}", full_name, SummariseList(exists_mismatches));
+    }
+    if (!maker_report.empty()) {
+        LogNTr(spdlog::level::warn, "Rust group validation {}: {}", full_name, maker_report);
+    }
+    if (!root_report.empty()) {
+        LogNTr(spdlog::level::warn, "Rust group validation {}: {}", full_name, root_report);
+    }
+#endif
+}
