+    snapshot.scenario_year_speed = CollectScenarioValue(game.C4S.Weather.YearSpeed);
+    snapshot.scenario_climate = CollectScenarioValue(game.C4S.Weather.Climate);
+    snapshot.scenario_rain = CollectScenarioValue(game.C4S.Weather.Rain);
+    snapshot.scenario_lightning = CollectScenarioValue(game.C4S.Weather.Lightning);
+    snapshot.scenario_wind = CollectScenarioValue(game.C4S.Weather.Wind);
+    snapshot.scenario_meteorite = CollectScenarioValue(game.C4S.Disasters.Meteorite);
+    snapshot.scenario_volcano = CollectScenarioValue(game.C4S.Disasters.Volcano);
+    snapshot.scenario_earthquake = CollectScenarioValue(game.C4S.Disasters.Earthquake);
+    const char *precipitation = game.C4S.Weather.Precipitation;
+    size_t precipitation_length = 0;
+    while (precipitation_length < LC_ENGINE_RUNTIME_PRECIPITATION_CAPACITY &&
+           precipitation[precipitation_length] != '\0') {
+        ++precipitation_length;
+    }
+    if (precipitation_length != 0) {
+        std::memcpy(
+            snapshot.precipitation_material,
+            precipitation,
+            precipitation_length);
+    }
+    snapshot.precipitation_material_len =
+        static_cast<uint8_t>(precipitation_length);
+    snapshot.no_gamma = game.Weather.NoGamma ? 1u : 0u;
+    snapshot.no_initialize = game.C4S.Head.NoInitialize ? 1u : 0u;
+    snapshot.scenario_no_gamma = game.C4S.Weather.NoGamma ? 1u : 0u;
+    snapshot.initial_rain_gate_valid =
+        game.Weather.RustEngineValidationInitialRainGateValid ? 1u : 0u;
+    return snapshot;
+}
