+class LandscapeStateEncoder {
+public:
+    explicit LandscapeStateEncoder(std::vector<uint8_t> &bytes)
+        : bytes(bytes) {}
+
+    void PushU8(uint8_t value) { bytes.push_back(value); }
+
+    void PushBool(bool value) { PushU8(value ? 1u : 0u); }
+
+    void PushU32(uint32_t value) {
+        for (unsigned int shift = 0; shift < 32; shift += 8) {
+            bytes.push_back(static_cast<uint8_t>(value >> shift));
+        }
+    }
+
+    void PushI32(int32_t value) { PushU32(static_cast<uint32_t>(value)); }
+
+    bool PushLength(size_t length, const std::string &label, std::string &error) {
+        if (length > std::numeric_limits<uint32_t>::max()) {
+            error = label + " exceeds u32";
+            return false;
+        }
+        PushU32(static_cast<uint32_t>(length));
+        return true;
+    }
+
+    bool PushBytes(
+        const uint8_t *value,
+        size_t length,
+        const std::string &label,
+        std::string &error) {
+        if (length != 0 && !value) {
+            error = label + " is null with a nonzero length";
+            return false;
+        }
+        if (length != 0 &&
+            std::find(value, value + length, uint8_t{0}) != value + length) {
+            error = label + " contains an embedded NUL";
+            return false;
+        }
+        if (!PushLength(length, label + " length", error)) {
+            return false;
+        }
+        if (length != 0) {
+            bytes.insert(bytes.end(), value, value + length);
+        }
+        return true;
+    }
+
+    bool PushRawBytes(
+        const uint8_t *value,
+        size_t length,
+        const std::string &label,
+        std::string &error) {
+        if (length != 0 && !value) {
+            error = label + " is null with a nonzero length";
+            return false;
+        }
+        if (!PushLength(length, label + " length", error)) {
+            return false;
+        }
+        AppendRaw(value, length);
+        return true;
+    }
+
+    void AppendRaw(const uint8_t *value, size_t length) {
+        if (length != 0) {
+            bytes.insert(bytes.end(), value, value + length);
+        }
+    }
+
+    bool PushCString(
+        const char *value,
+        size_t capacity,
+        const std::string &label,
+        std::string &error) {
+        std::vector<uint8_t> encoded;
+        if (!BoundedCStringBytes(value, capacity, encoded, label, error)) {
+            return false;
+        }
+        return PushBytes(encoded.data(), encoded.size(), label, error);
+    }
+
+private:
+    std::vector<uint8_t> &bytes;
+};
+
+static_assert(PXSChunkSize == 500, "native PXS chunk size changed");
+static_assert(PXSMaxChunk == 20, "native PXS chunk count changed");
+static_assert(PXSMaxChunk <= 32, "PXS allocated-chunk mask exceeds u32");
+static_assert(C4MassMoverChunk == 10000, "native mass-mover capacity changed");
+
+struct PxsValidationRecord {
+    uint32_t chunk;
+    uint32_t slot;
+    int32_t material;
+    int32_t x;
+    int32_t y;
+    int32_t xdir;
+    int32_t ydir;
+};
+
+bool EncodePxsState(
+    const C4PXSSystem &system,
+    std::vector<uint8_t> &bytes,
+    std::string &error) {
+    struct ChunkAddressRange {
+        uintptr_t begin;
+        uintptr_t end;
+        size_t index;
+    };
+    std::vector<ChunkAddressRange> ranges;
+    std::array<uint32_t, PXSMaxChunk> chunk_counts{};
+    std::vector<PxsValidationRecord> records;
+    uint32_t allocated_chunk_mask = 0;
+    for (size_t chunk_index = 0; chunk_index < PXSMaxChunk; ++chunk_index) {
+        const C4PXS *chunk =
+            RustEngineLandscapeValidationAccess::PxsChunk(system, chunk_index);
+        const size_t expected_live =
+            RustEngineLandscapeValidationAccess::PxsChunkCount(
+                system,
+                chunk_index);
+        if (expected_live > PXSChunkSize) {
+            error = std::format(
+                "PXS chunk {} occupancy {} exceeds {}",
+                chunk_index,
+                expected_live,
+                PXSChunkSize);
+            return false;
+        }
+        chunk_counts[chunk_index] = static_cast<uint32_t>(expected_live);
+        if (!chunk) {
+            if (expected_live != 0) {
+                error = std::format(
+                    "PXS chunk {} is null with occupancy {}",
+                    chunk_index,
+                    expected_live);
+                return false;
+            }
+            continue;
+        }
+
+        const uintptr_t begin = reinterpret_cast<uintptr_t>(chunk);
+        constexpr size_t chunk_bytes = sizeof(C4PXS) * PXSChunkSize;
+        if (begin % alignof(C4PXS) != 0 ||
+            begin > std::numeric_limits<uintptr_t>::max() - chunk_bytes) {
+            error = std::format(
+                "PXS chunk {} has an invalid storage address",
+                chunk_index);
+            return false;
+        }
+        const uintptr_t end = begin + chunk_bytes;
+        for (const auto &range : ranges) {
+            if (begin < range.end && range.begin < end) {
+                error = std::format(
+                    "PXS chunks {} and {} alias storage",
+                    range.index,
+                    chunk_index);
+                return false;
+            }
+        }
+        ranges.push_back({begin, end, chunk_index});
+        allocated_chunk_mask |= uint32_t{1} << chunk_index;
+
+        size_t actual_live = 0;
+        for (size_t slot = 0; slot < PXSChunkSize; ++slot) {
+            const C4PXS &pxs = chunk[slot];
+            const int32_t material =
+                RustEngineLandscapeValidationAccess::PxsMaterial(pxs);
+            if (material == MNone) {
+                continue;
+            }
+            ++actual_live;
+            records.push_back({
+                static_cast<uint32_t>(chunk_index),
+                static_cast<uint32_t>(slot),
+                material,
+                RustEngineLandscapeValidationAccess::PxsX(pxs),
+                RustEngineLandscapeValidationAccess::PxsY(pxs),
+                RustEngineLandscapeValidationAccess::PxsXDir(pxs),
+                RustEngineLandscapeValidationAccess::PxsYDir(pxs),
+            });
+        }
+        if (actual_live != expected_live) {
+            error = std::format(
+                "PXS chunk {} occupancy ledger {}, scanned {}",
+                chunk_index,
+                expected_live,
+                actual_live);
+            return false;
+        }
+    }
+
+    bytes.clear();
+    LandscapeStateEncoder encoder(bytes);
+    encoder.AppendRaw(reinterpret_cast<const uint8_t *>("LCPX"), 4);
+    encoder.PushU32(1);
+    encoder.PushI32(system.Count);
+    encoder.PushU32(allocated_chunk_mask);
+    for (uint32_t count : chunk_counts) {
+        encoder.PushI32(static_cast<int32_t>(count));
+    }
+    if (!encoder.PushLength(records.size(), "PXS live slot count", error)) {
+        return false;
+    }
+    for (const auto &record : records) {
+        encoder.PushU32(record.chunk);
+        encoder.PushU32(record.slot);
+        encoder.PushI32(record.material);
+        encoder.PushI32(record.x);
+        encoder.PushI32(record.y);
+        encoder.PushI32(record.xdir);
+        encoder.PushI32(record.ydir);
+    }
+    return true;
+}
+
+struct MassMoverValidationRecord {
+    uint32_t index;
+    int32_t material;
+    int32_t x;
+    int32_t y;
+};
+
+bool EncodeMassMoverState(
+    const C4MassMoverSet &set,
+    std::vector<uint8_t> &bytes,
+    std::string &error) {
+    if (set.CreatePtr < 0 || set.CreatePtr >= C4MassMoverChunk) {
+        error = std::format(
+            "mass-mover CreatePtr {} is outside 0..{}",
+            set.CreatePtr,
+            C4MassMoverChunk - 1);
+        return false;
+    }
+
+    std::vector<MassMoverValidationRecord> records;
+    records.reserve(C4MassMoverChunk);
+    for (size_t index = 0; index < C4MassMoverChunk; ++index) {
+        const C4MassMover &mover =
+            RustEngineLandscapeValidationAccess::MassMoverAt(set, index);
+        const int32_t material =
+            RustEngineLandscapeValidationAccess::MassMoverMaterial(mover);
+        if (material == MNone) {
+            continue;
+        }
+        records.push_back({
+            static_cast<uint32_t>(index),
+            material,
+            RustEngineLandscapeValidationAccess::MassMoverX(mover),
+            RustEngineLandscapeValidationAccess::MassMoverY(mover),
+        });
+    }
+
+    bytes.clear();
+    LandscapeStateEncoder encoder(bytes);
+    encoder.AppendRaw(reinterpret_cast<const uint8_t *>("LCMM"), 4);
+    encoder.PushU32(1);
+    encoder.PushI32(set.Count);
+    encoder.PushI32(set.CreatePtr);
+    if (!encoder.PushLength(records.size(), "mass-mover live slot count", error)) {
+        return false;
+    }
+    for (const auto &record : records) {
+        encoder.PushU32(record.index);
+        encoder.PushI32(record.material);
+        encoder.PushI32(record.x);
+        encoder.PushI32(record.y);
+    }
+    return true;
+}
+
+bool PushMaterialString(
+    LandscapeStateEncoder &encoder,
+    const StdStrBuf &value,
+    const std::string &label,
+    std::string &error) {
+    return encoder.PushRawBytes(
+        reinterpret_cast<const uint8_t *>(value.getData()),
+        value.getLength(),
+        label,
+        error);
+}
+
+const char *MaterialReactionTypeName(const C4MaterialReaction &reaction) {
+    if (reaction.pFunc == &C4MaterialMap::mrfScript) {
+        return "Script";
+    }
+    if (reaction.pFunc == &C4MaterialMap::mrfConvert) {
+        return "Convert";
+    }
+    if (reaction.pFunc == &C4MaterialMap::mrfPoof) {
+        return "Poof";
+    }
+    if (reaction.pFunc == &C4MaterialMap::mrfCorrode) {
+        return "Corrode";
+    }
+    if (reaction.pFunc == &C4MaterialMap::mrfInsert) {
+        return "Insert";
+    }
+    // C4MaterialReaction::CompileFunc decompiles NoReaction and function
+    // pointers outside ReactionFuncMap as the empty Type value.
+    return "";
+}
+
+bool EncodeMaterialBehaviorState(
+    const C4MaterialMap &materials,
+    std::vector<uint8_t> &bytes,
+    std::string &error) {
+    if (materials.Num < 0 ||
+        materials.Num >
+            static_cast<int32_t>(LC_ENGINE_RUNTIME_LANDSCAPE_MATERIAL_CAPACITY)) {
+        error = std::format(
+            "material behavior count {} is outside 0..{}",
+            materials.Num,
+            LC_ENGINE_RUNTIME_LANDSCAPE_MATERIAL_CAPACITY);
+        return false;
+    }
+    if (materials.Num != 0 && !materials.Map) {
+        error = "material behavior map has a nonzero count but no entries";
+        return false;
+    }
+
+    bytes.clear();
+    LandscapeStateEncoder encoder(bytes);
+    encoder.AppendRaw(reinterpret_cast<const uint8_t *>("LCMB"), 4);
+    encoder.PushU32(1);
+    encoder.PushU32(static_cast<uint32_t>(materials.Num));
+    for (int32_t index = 0; index < materials.Num; ++index) {
+        const C4Material &material = materials.Map[index];
+        const std::string label = std::format("material behavior {}", index);
+        if (!encoder.PushCString(
+                material.Name,
+                sizeof(material.Name),
+                label + " Name",
+                error)) {
+            return false;
+        }
+        for (uint32_t value : material.Color) {
+            encoder.PushU32(value);
+        }
+        for (uint32_t value : material.Alpha) {
+            encoder.PushU32(value);
+        }
+        for (int32_t value : {
+                 material.MapChunkType,
+                 material.Density,
+                 material.Friction,
+                 material.DigFree,
+                 material.BlastFree,
+             }) {
+            encoder.PushI32(value);
+        }
+        encoder.PushU32(static_cast<uint32_t>(material.Blast2Object));
+        encoder.PushU32(static_cast<uint32_t>(material.Dig2Object));
+        for (int32_t value : {
+                 material.Dig2ObjectRatio,
+                 material.Dig2ObjectOnRequestOnly,
+                 material.Blast2ObjectRatio,
+                 material.Blast2PXSRatio,
+                 material.Instable,
+                 material.MaxAirSpeed,
+                 material.MaxSlide,
+                 material.WindDrift,
+                 material.Inflammable,
+                 material.Incindiary,
+                 material.Corrode,
+                 material.Corrosive,
+                 material.Extinguisher,
+                 material.Soil,
+                 material.Placement,
+             }) {
+            encoder.PushI32(value);
+        }
+        if (!PushMaterialString(
+                encoder,
+                material.sTextureOverlay,
+                label + " TextureOverlay",
+                error)) {
+            return false;
+        }
+        encoder.PushI32(material.OverlayType);
+        if (!PushMaterialString(
+                encoder,
+                material.sPXSGfx,
+                label + " PXSGfx",
+                error)) {
+            return false;
+        }
+        for (int32_t value : {
+                 material.PXSGfxRt.x,
+                 material.PXSGfxRt.y,
+                 material.PXSGfxRt.Wdt,
+                 material.PXSGfxRt.Hgt,
+                 material.PXSGfxRt.tx,
+                 material.PXSGfxRt.ty,
+                 material.PXSGfxSize,
+                 material.TempConvStrength,
+             }) {
+            encoder.PushI32(value);
+        }
+        if (!PushMaterialString(
+                encoder,
+                material.sBlastShiftTo,
+                label + " BlastShiftTo",
+                error) ||
+            !PushMaterialString(
+                encoder,
+                material.sInMatConvert,
+                label + " InMatConvert",
+                error) ||
+            !PushMaterialString(
+                encoder,
+                material.sInMatConvertTo,
+                label + " InMatConvertTo",
+                error)) {
+            return false;
+        }
+        encoder.PushI32(material.InMatConvertDepth);
+        encoder.PushI32(material.AboveTempConvert);
+        encoder.PushI32(material.AboveTempConvertDir);
+        if (!PushMaterialString(
+                encoder,
+                material.sAboveTempConvertTo,
+                label + " AboveTempConvertTo",
+                error)) {
+            return false;
+        }
+        encoder.PushI32(material.BelowTempConvert);
+        encoder.PushI32(material.BelowTempConvertDir);
+        if (!PushMaterialString(
+                encoder,
+                material.sBelowTempConvertTo,
+                label + " BelowTempConvertTo",
+                error)) {
+            return false;
+        }
+        encoder.PushI32(material.MinHeightCount);
+        encoder.PushI32(material.SplashRate);
+
+        if (!encoder.PushLength(
+                material.CustomReactionList.size(),
+                label + " reaction count",
+                error)) {
+            return false;
+        }
+        for (size_t reaction_index = 0;
+             reaction_index < material.CustomReactionList.size();
+             ++reaction_index) {
+            const C4MaterialReaction &reaction =
+                material.CustomReactionList[reaction_index];
+            const std::string reaction_label = std::format(
+                "{} reaction {}",
+                label,
+                reaction_index);
+            const char *type = MaterialReactionTypeName(reaction);
+            if (!encoder.PushRawBytes(
+                    reinterpret_cast<const uint8_t *>(type),
+                    std::strlen(type),
+                    reaction_label + " Type",
+                    error) ||
+                !PushMaterialString(
+                    encoder,
+                    reaction.TargetSpec,
+                    reaction_label + " TargetSpec",
+                    error) ||
+                !PushMaterialString(
+                    encoder,
+                    reaction.ScriptFunc,
+                    reaction_label + " ScriptFunc",
+                    error)) {
+                return false;
+            }
+            encoder.PushU32(reaction.iExecMask);
+            encoder.PushBool(reaction.fReverse);
+            encoder.PushBool(reaction.fInverseSpec);
+            encoder.PushBool(reaction.fInsertionCheck);
+            encoder.PushI32(reaction.iDepth);
+            if (!PushMaterialString(
+                    encoder,
+                    reaction.sConvertMat,
+                    reaction_label + " ConvertMat",
+                    error)) {
+                return false;
+            }
+            encoder.PushI32(reaction.iCorrosionRate);
+        }
+    }
+    return true;
+}
+
+template<typename IntBool>
+bool PushMapCreatorIntBool(
+    LandscapeStateEncoder &encoder,
+    const IntBool &value) {
+    encoder.PushI32(RustEngineLandscapeValidationAccess::IntBoolValue(value));
+    encoder.PushBool(RustEngineLandscapeValidationAccess::IntBoolPercent(value));
+    return true;
+}
+
+bool MapCreatorOperationTag(
+    C4MCTokenType operation,
+    uint8_t &tag,
+    std::string &error) {
+    switch (operation) {
+    case MCT_NONE: tag = 0; return true;
+    case MCT_AND: tag = 1; return true;
+    case MCT_OR: tag = 2; return true;
+    case MCT_XOR: tag = 3; return true;
+    default:
+        error = std::format("map creator overlay has invalid operation {}", static_cast<int>(operation));
+        return false;
+    }
+}
+
+bool MapCreatorAlgorithmTag(
+    const C4MCAlgorithm *algorithm,
+    uint8_t &tag,
+    std::string &error) {
+    for (uint8_t index = 0; index < 14; ++index) {
+        if (algorithm == &C4MCAlgoMap[index]) {
+            tag = index;
+            return true;
+        }
+    }
+    error = "map creator overlay has an unknown algorithm pointer";
+    return false;
+}
+
+bool PushMapCreatorCallbackOrdinal(
+    LandscapeStateEncoder &encoder,
+    const C4MCCallbackArray *callback,
+    const std::unordered_map<const C4MCCallbackArray *, int32_t> &ordinals,
+    const std::string &label,
+    std::string &error) {
+    if (!callback) {
+        encoder.PushI32(-1);
+        return true;
+    }
+    const auto found = ordinals.find(callback);
+    if (found == ordinals.end()) {
+        error = label + " references a callback outside the creator list";
+        return false;
+    }
+    encoder.PushI32(found->second);
+    return true;
+}
+
+bool EncodeMapCreatorOverlay(
+    const C4MCOverlay &overlay,
+    LandscapeStateEncoder &encoder,
+    const std::unordered_map<const C4MCCallbackArray *, int32_t> &callback_ordinals,
+    const std::string &label,
+    std::string &error) {
+    for (int32_t value : {
+             overlay.Seed,
+             overlay.FixedSeed,
+             overlay.X,
+             overlay.Y,
+             overlay.Wdt,
+             overlay.Hgt,
+             overlay.OffX,
+             overlay.OffY,
+         }) {
+        encoder.PushI32(value);
+    }
+    PushMapCreatorIntBool(encoder, overlay.RX);
+    PushMapCreatorIntBool(encoder, overlay.RY);
+    PushMapCreatorIntBool(encoder, overlay.RWdt);
+    PushMapCreatorIntBool(encoder, overlay.RHgt);
+    PushMapCreatorIntBool(encoder, overlay.ROffX);
+    PushMapCreatorIntBool(encoder, overlay.ROffY);
+    encoder.PushI32(overlay.Material);
+    encoder.PushBool(overlay.Sub);
+    if (!encoder.PushCString(
+            overlay.Texture,
+            sizeof(overlay.Texture),
+            label + " texture",
+            error)) {
+        return false;
+    }
+    encoder.PushU8(overlay.MatClr);
+    uint8_t operation = 0;
+    if (!MapCreatorOperationTag(overlay.Op, operation, error)) {
+        error = label + ": " + error;
+        return false;
+    }
+    encoder.PushU8(operation);
+    uint8_t algorithm = 0;
+    if (!MapCreatorAlgorithmTag(overlay.Algorithm, algorithm, error)) {
+        error = label + ": " + error;
+        return false;
+    }
+    encoder.PushU8(algorithm);
+    encoder.PushI32(overlay.Turbulence);
+    encoder.PushI32(overlay.Lambda);
+    encoder.PushI32(overlay.Rotate);
+    PushMapCreatorIntBool(encoder, overlay.Alpha);
+    PushMapCreatorIntBool(encoder, overlay.Beta);
+    encoder.PushI32(overlay.ZoomX);
+    encoder.PushI32(overlay.ZoomY);
+    encoder.PushBool(overlay.Invert);
+    encoder.PushBool(overlay.LooseBounds);
+    encoder.PushBool(overlay.Group);
+    encoder.PushBool(overlay.Mask);
+    if (!PushMapCreatorCallbackOrdinal(
+            encoder,
+            overlay.pEvaluateFunc,
+            callback_ordinals,
+            label + " evalFn",
+            error)) {
+        return false;
+    }
+    return PushMapCreatorCallbackOrdinal(
+        encoder,
+        overlay.pDrawFunc,
+        callback_ordinals,
+        label + " drawFn",
+        error);
+}
+
+bool EncodeMapCreatorPoint(
+    const C4MCPoint &point,
+    LandscapeStateEncoder &encoder) {
+    encoder.PushI32(point.X);
+    encoder.PushI32(point.Y);
+    encoder.PushBool(point.RustEngineValidationRXSet);
+    if (point.RustEngineValidationRXSet) {
+        PushMapCreatorIntBool(encoder, point.RX);
+    }
+    encoder.PushBool(point.RustEngineValidationRYSet);
+    if (point.RustEngineValidationRYSet) {
+        PushMapCreatorIntBool(encoder, point.RY);
+    }
+    return true;
+}
+
+bool ValidateDetachedMapCreatorTemplate(
+    const C4MCNode &node,
+    const C4MapCreatorS2 &creator,
+    C4MCNodeType expected_type,
+    const std::string &label,
+    std::string &error) {
+    if (node.Owner || node.Child0 || node.ChildL || node.Prev || node.Next) {
+        error = label + " has unexpected tree links";
+        return false;
+    }
+    if (node.MapCreator != &creator) {
+        error = label + " has the wrong owning creator";
+        return false;
+    }
+    if (const_cast<C4MCNode &>(node).Type() != expected_type) {
+        error = label + " has the wrong node type";
+        return false;
+    }
+    return true;
+}
+
+template<typename IntBool>
+bool MapCreatorIntBoolEquals(
+    const IntBool &value,
+    int32_t expected_value,
+    bool expected_percent) {
+    return RustEngineLandscapeValidationAccess::IntBoolValue(value) ==
+            expected_value &&
+        RustEngineLandscapeValidationAccess::IntBoolPercent(value) ==
+            expected_percent;
+}
+
+bool ValidateCanonicalMapCreatorDefaults(
+    const C4MCOverlay &overlay,
+    const C4MCPoint &point,
+    std::string &error) {
+    if (overlay.Name[0] != '\0' || overlay.Seed != 0 ||
+        overlay.FixedSeed != 0 || overlay.X != 0 || overlay.Y != 0 ||
+        overlay.Wdt != C4MC_SizeRes || overlay.Hgt != C4MC_SizeRes ||
+        overlay.OffX != 0 || overlay.OffY != 0 ||
+        !MapCreatorIntBoolEquals(overlay.RX, 0, true) ||
+        !MapCreatorIntBoolEquals(overlay.RY, 0, true) ||
+        !MapCreatorIntBoolEquals(overlay.RWdt, C4MC_SizeRes, true) ||
+        !MapCreatorIntBoolEquals(overlay.RHgt, C4MC_SizeRes, true) ||
+        !MapCreatorIntBoolEquals(overlay.ROffX, 0, true) ||
+        !MapCreatorIntBoolEquals(overlay.ROffY, 0, true) ||
+        overlay.Material != MNone || !overlay.Sub || overlay.Texture[0] != '\0' ||
+        overlay.MatClr != 0 || overlay.Op != MCT_NONE ||
+        overlay.Algorithm != &C4MCAlgoMap[0] || overlay.Turbulence != 0 ||
+        overlay.Lambda != 0 || overlay.Rotate != 0 ||
+        !MapCreatorIntBoolEquals(overlay.Alpha, 0, false) ||
+        !MapCreatorIntBoolEquals(overlay.Beta, 0, false) ||
+        overlay.ZoomX != C4MC_ZoomRes || overlay.ZoomY != C4MC_ZoomRes ||
+        overlay.Invert || overlay.LooseBounds || overlay.Group || overlay.Mask ||
+        overlay.pEvaluateFunc || overlay.pDrawFunc) {
+        error = "map creator default overlay is not canonical";
+        return false;
+    }
+    // DefaultPoint::Default resets only evaluated X/Y. RX/RY are written by
+    // every parsed point field and are intentionally not read while detached.
+    if (point.Name[0] != '\0' || point.X != 0 || point.Y != 0 ||
+        point.RustEngineValidationRXSet || point.RustEngineValidationRYSet) {
+        error = "map creator default point is not canonical";
+        return false;
+    }
+    return true;
+}
+
+struct MapCreatorEncodingContext {
+    C4MapCreatorS2 &creator;
+    LandscapeStateEncoder &encoder;
+    const std::unordered_map<const C4MCCallbackArray *, int32_t> &callback_ordinals;
+    std::unordered_set<const C4MCNode *> visited;
+    std::string &error;
+};
+
+bool EncodeMapCreatorNode(
+    C4MCNode &node,
+    C4MCNode *expected_owner,
+    MapCreatorEncodingContext &context) {
+    if (!context.visited.insert(&node).second) {
+        context.error = std::format(
+            "map creator node \"{}\" is referenced more than once",
+            node.Name);
+        return false;
+    }
+    if (node.Owner != expected_owner) {
+        context.error = std::format(
+            "map creator node \"{}\" has an inconsistent owner",
+            node.Name);
+        return false;
+    }
+    if (node.MapCreator != &context.creator) {
+        context.error = std::format(
+            "map creator node \"{}\" has the wrong creator",
+            node.Name);
+        return false;
+    }
+
+    const C4MCNodeType type = node.Type();
+    uint8_t tag = 0;
+    switch (type) {
+    case MCN_Node:
+        if (&node != static_cast<C4MCNode *>(&context.creator)) {
+            context.error = "map creator tree contains an extra root node";
+            return false;
+        }
+        tag = 0;
+        break;
+    case MCN_Overlay: tag = 1; break;
+    case MCN_Point: tag = 2; break;
+    case MCN_Map:
+        if (expected_owner != static_cast<C4MCNode *>(&context.creator)) {
+            context.error = std::format(
+                "map creator map node \"{}\" is not global",
+                node.Name);
+            return false;
+        }
+        tag = 3;
+        break;
+    default:
+        context.error = std::format(
+            "map creator node \"{}\" has invalid type {}",
+            node.Name,
+            static_cast<int>(type));
+        return false;
+    }
+    context.encoder.PushU8(tag);
+    if (!context.encoder.PushCString(
+            node.Name,
+            sizeof(node.Name),
+            "map creator node name",
+            context.error)) {
+        return false;
+    }
+    if ((type == MCN_Overlay || type == MCN_Map) &&
+        !EncodeMapCreatorOverlay(
+            static_cast<C4MCOverlay &>(node),
+            context.encoder,
+            context.callback_ordinals,
+            std::format("map creator node \"{}\"", node.Name),
+            context.error)) {
+        return false;
+    }
+    if (type == MCN_Point) {
+        EncodeMapCreatorPoint(static_cast<C4MCPoint &>(node), context.encoder);
+    }
+
+    std::vector<C4MCNode *> children;
+    std::unordered_set<const C4MCNode *> sibling_seen;
+    C4MCNode *previous = nullptr;
+    for (C4MCNode *child = node.Child0; child; child = child->Next) {
+        if (!sibling_seen.insert(child).second) {
+            context.error = std::format(
+                "map creator node \"{}\" has a cyclic child list",
+                node.Name);
+            return false;
+        }
+        if (child->Prev != previous) {
+            context.error = std::format(
+                "map creator child \"{}\" has an inconsistent Prev link",
+                child->Name);
+            return false;
+        }
+        children.push_back(child);
+        previous = child;
+    }
+    if (node.ChildL != previous || (node.Child0 == nullptr) != (node.ChildL == nullptr)) {
+        context.error = std::format(
+            "map creator node \"{}\" has inconsistent first/last child links",
+            node.Name);
+        return false;
+    }
+    if (!context.encoder.PushLength(
+            children.size(),
+            "map creator child count",
+            context.error)) {
+        return false;
+    }
+    for (C4MCNode *child : children) {
+        if (!EncodeMapCreatorNode(*child, &node, context)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool EncodeMapCreatorState(
+    C4Game &game,
+    C4MapCreatorS2 &creator,
+    std::vector<uint8_t> &bytes,
+    std::string &error) {
+    if (RustEngineLandscapeValidationAccess::CreatorLandscape(creator) !=
+            &game.C4S.Landscape ||
+        RustEngineLandscapeValidationAccess::CreatorTexMap(creator) !=
+            &game.TextureMap ||
+        RustEngineLandscapeValidationAccess::CreatorMatMap(creator) !=
+            &game.Material) {
+        error = "map creator retains foreign landscape/material/texture inputs";
+        return false;
+    }
+    if (RustEngineLandscapeValidationAccess::CreatorCurrentMap(creator)) {
+        error = "map creator still has a current render target at the frame boundary";
+        return false;
+    }
+    if (creator.Owner || creator.Prev || creator.Next) {
+        error = "map creator root has unexpected outer links";
+        return false;
+    }
+    if (creator.MapCreator != &creator || creator.Type() != MCN_Node) {
+        error = "map creator root has invalid ownership or type";
+        return false;
+    }
+
+    const C4MCMap &default_map =
+        RustEngineLandscapeValidationAccess::CreatorDefaultMap(creator);
+    const C4MCOverlay &default_overlay =
+        RustEngineLandscapeValidationAccess::CreatorDefaultOverlay(creator);
+    const C4MCPoint &default_point =
+        RustEngineLandscapeValidationAccess::CreatorDefaultPoint(creator);
+    if (!ValidateDetachedMapCreatorTemplate(
+            default_map, creator, MCN_Map, "map creator default map", error) ||
+        !ValidateDetachedMapCreatorTemplate(
+            default_overlay,
+            creator,
+            MCN_Overlay,
+            "map creator default overlay",
+            error) ||
+        !ValidateDetachedMapCreatorTemplate(
+            default_point,
+            creator,
+            MCN_Point,
+            "map creator default point",
+            error) ||
+        !ValidateCanonicalMapCreatorDefaults(default_overlay, default_point, error)) {
+        return false;
+    }
+
+    std::vector<const C4MCCallbackArray *> callbacks;
+    std::unordered_set<const C4MCCallbackArray *> callback_seen;
+    for (const C4MCCallbackArray *callback =
+             RustEngineLandscapeValidationAccess::CreatorFirstCallback(creator);
+         callback;
+         callback = RustEngineLandscapeValidationAccess::CallbackNext(*callback)) {
+        if (!callback_seen.insert(callback).second) {
+            error = "map creator callback list is cyclic";
+            return false;
+        }
+        if (RustEngineLandscapeValidationAccess::CallbackCreator(*callback) != &creator) {
+            error = "map creator callback has the wrong owning creator";
+            return false;
+        }
+        if (!RustEngineLandscapeValidationAccess::CallbackFunction(*callback)) {
+            error = "map creator callback has no script function";
+            return false;
+        }
+        if (callbacks.size() >= static_cast<size_t>(std::numeric_limits<int32_t>::max())) {
+            error = "map creator callback count exceeds i32";
+            return false;
+        }
+        callbacks.push_back(callback);
+    }
+    std::unordered_map<const C4MCCallbackArray *, int32_t> callback_ordinals;
+    callback_ordinals.reserve(callbacks.size());
+    for (size_t index = 0; index < callbacks.size(); ++index) {
+        callback_ordinals.emplace(callbacks[index], static_cast<int32_t>(index));
+    }
+
+    bytes.clear();
+    LandscapeStateEncoder encoder(bytes);
+    encoder.AppendRaw(reinterpret_cast<const uint8_t *>("LCMC"), 4);
+    encoder.PushU32(1);
+    encoder.PushU8(3);
+    if (!EncodeMapCreatorOverlay(
+            default_map,
+            encoder,
+            callback_ordinals,
+            "map creator default map",
+            error)) {
+        return false;
+    }
+
+    MapCreatorEncodingContext context{
+        creator,
+        encoder,
+        callback_ordinals,
+        {},
+        error,
+    };
+    if (!EncodeMapCreatorNode(creator, nullptr, context)) {
+        return false;
+    }
+
+    if (!encoder.PushLength(callbacks.size(), "map creator callback count", error)) {
+        return false;
+    }
+    for (size_t index = 0; index < callbacks.size(); ++index) {
+        const C4MCCallbackArray &callback = *callbacks[index];
+        const C4AulFunc *function =
+            RustEngineLandscapeValidationAccess::CallbackFunction(callback);
+        if (!encoder.PushCString(
+                function->Name,
+                sizeof(function->Name),
+                std::format("map creator callback {} function", index),
+                error)) {
+            return false;
+        }
+        const uint8_t *bitmap =
+            RustEngineLandscapeValidationAccess::CallbackMap(callback);
+        if (!bitmap) {
+            encoder.PushU8(0);
+            continue;
+        }
+        const int32_t width =
+            RustEngineLandscapeValidationAccess::CallbackWidth(callback);
+        const int32_t height =
+            RustEngineLandscapeValidationAccess::CallbackHeight(callback);
+        if (width <= 0 || height <= 0) {
+            error = std::format(
+                "map creator callback {} has allocated bits with dimensions {}x{}",
+                index,
+                width,
+                height);
+            return false;
+        }
+        size_t pixel_count = 0;
+        if (!CheckedProduct(
+                static_cast<size_t>(width),
+                static_cast<size_t>(height),
+                pixel_count) ||
+            pixel_count > std::numeric_limits<size_t>::max() - 7) {
+            error = std::format("map creator callback {} dimensions overflow", index);
+            return false;
+        }
+        const size_t bitmap_length = (pixel_count + 7) / 8;
+        const size_t used_last_bits = pixel_count % 8;
+        if (used_last_bits != 0 &&
+            (bitmap[bitmap_length - 1] &
+             static_cast<uint8_t>(~((uint8_t{1} << used_last_bits) - 1))) != 0) {
+            error = std::format(
+                "map creator callback {} has set bitmap padding bits",
+                index);
+            return false;
+        }
+        encoder.PushU8(1);
+        encoder.PushI32(width);
+        encoder.PushI32(height);
+        if (!encoder.PushLength(
+                bitmap_length,
+                std::format("map creator callback {} bitmap length", index),
+                error)) {
+            return false;
+        }
+        encoder.AppendRaw(bitmap, bitmap_length);
+    }
+    return true;
+}
+
+uint8_t FoldC4NameByte(uint8_t value) {
+    if (value >= static_cast<uint8_t>('A') && value <= static_cast<uint8_t>('Z')) {
+        return static_cast<uint8_t>(value + ('a' - 'A'));
+    }
+    switch (value) {
+    case 0xc4:
+    case 0xe4: return 0xe4;
+    case 0xd6:
+    case 0xf6: return 0xf6;
+    case 0xdc:
+    case 0xfc: return 0xfc;
+    default: return value;
+    }
+}
+
+bool EncodeTextureInventory(
+    const C4TextureMap &texture_map,
+    std::vector<uint8_t> &bytes,
+    std::string &error) {
+    std::vector<std::vector<uint8_t>> names;
+    std::unordered_set<const C4Texture *> seen;
+    for (const C4Texture *texture =
+             RustEngineLandscapeValidationAccess::FirstTexture(texture_map);
+         texture;
+         texture = RustEngineLandscapeValidationAccess::NextTexture(*texture)) {
+        if (!seen.insert(texture).second) {
+            error = "texture inventory list is cyclic";
+            return false;
+        }
+        std::vector<uint8_t> name;
+        if (!BoundedCStringBytes(
+                RustEngineLandscapeValidationAccess::TextureName(*texture),
+                C4M_MaxName + 1,
+                name,
+                "texture inventory name",
+                error)) {
+            return false;
+        }
+        std::transform(name.begin(), name.end(), name.begin(), FoldC4NameByte);
+        names.push_back(std::move(name));
+    }
+    std::sort(names.begin(), names.end());
+    names.erase(std::unique(names.begin(), names.end()), names.end());
+
+    bytes.clear();
+    LandscapeStateEncoder encoder(bytes);
+    encoder.AppendRaw(reinterpret_cast<const uint8_t *>("LCTX"), 4);
+    encoder.PushU32(1);
+    if (!encoder.PushLength(names.size(), "texture inventory count", error)) {
+        return false;
+    }
+    for (const auto &name : names) {
+        if (!encoder.PushLength(name.size(), "texture inventory name length", error)) {
+            return false;
+        }
+        encoder.AppendRaw(name.data(), name.size());
+    }
+    return true;
+}
+
+bool MaterialReactionKind(
+    const C4MaterialReaction &reaction,
+    uint8_t &kind,
+    std::string &error) {
+    if (reaction.pFunc == &C4MaterialReaction::NoReaction) {
+        kind = 0;
+    } else if (reaction.pFunc == &C4MaterialMap::mrfConvert) {
+        kind = 1;
+    } else if (reaction.pFunc == &C4MaterialMap::mrfPoof) {
+        kind = 2;
+    } else if (reaction.pFunc == &C4MaterialMap::mrfCorrode) {
+        kind = 3;
+    } else if (reaction.pFunc == &C4MaterialMap::mrfIncinerate) {
+        kind = 4;
+    } else if (reaction.pFunc == &C4MaterialMap::mrfInsert) {
+        kind = 5;
+    } else if (reaction.pFunc == &C4MaterialMap::mrfScript) {
+        kind = 6;
+    } else {
+        error = "material reaction table contains an unknown function pointer";
+        return false;
+    }
+    return true;
+}
+
+bool EncodeMaterialReactionState(
+    const C4MaterialMap &materials,
+    std::vector<uint8_t> &bytes,
+    std::string &error) {
+    if (materials.Num < 0 ||
+        materials.Num > static_cast<int32_t>(LC_ENGINE_RUNTIME_LANDSCAPE_MATERIAL_CAPACITY)) {
+        error = std::format(
+            "material reaction map count {} is outside 0..{}",
+            materials.Num,
+            LC_ENGINE_RUNTIME_LANDSCAPE_MATERIAL_CAPACITY);
+        return false;
+    }
+    if (materials.Num != 0 && !materials.Map) {
+        error = "material reaction map has a nonzero count but no material array";
+        return false;
+    }
+    if (!materials.ppReactionMap) {
+        error = "material reaction map has not been cross-mapped";
+        return false;
+    }
+
+    bytes.clear();
+    LandscapeStateEncoder encoder(bytes);
+    encoder.AppendRaw(reinterpret_cast<const uint8_t *>("LCMR"), 4);
+    encoder.PushU32(1);
+    encoder.PushU32(static_cast<uint32_t>(materials.Num));
+    const size_t width = static_cast<size_t>(materials.Num) + 1;
+    for (uint32_t event = 0; event < 3; ++event) {
+        for (int32_t landscape_material = -1;
+             landscape_material < materials.Num;
+             ++landscape_material) {
+            for (int32_t pxs_material = -1;
+                 pxs_material < materials.Num;
+                 ++pxs_material) {
+                const size_t index =
+                    static_cast<size_t>(landscape_material + 1) * width +
+                    static_cast<size_t>(pxs_material + 1);
+                const C4MaterialReaction *reaction = materials.ppReactionMap[index];
+                if (!reaction) {
+                    encoder.PushU8(0);
+                    encoder.PushBool(false);
+                    encoder.PushBool(true);
+                    continue;
+                }
+
+                const bool event_enabled =
+                    (reaction->iExecMask & (uint32_t{1} << event)) != 0;
+                if (reaction->fUserDefined && !event_enabled) {
+                    encoder.PushU8(0);
+                    encoder.PushBool(true);
+                    encoder.PushBool(false);
+                    continue;
+                }
+
+                uint8_t kind = 0;
+                if (!MaterialReactionKind(*reaction, kind, error)) {
+                    error = std::format(
+                        "{} at event {}, PXS material {}, landscape material {}",
+                        error,
+                        event,
+                        pxs_material,
+                        landscape_material);
+                    return false;
+                }
+                encoder.PushU8(kind);
+                encoder.PushBool(reaction->fUserDefined);
+                encoder.PushBool(reaction->fInsertionCheck);
+                switch (kind) {
+                case 1: {
+                    if (!reaction->fUserDefined && pxs_material < 0) {
+                        error = "builtin convert reaction has no PXS material";
+                        return false;
+                    }
+                    const int32_t target = reaction->fUserDefined
+                        ? reaction->iConvertMat
+                        : materials.Map[pxs_material].InMatConvertTo;
+                    const int32_t depth = reaction->fUserDefined
+                        ? reaction->iDepth
+                        : materials.Map[pxs_material].InMatConvertDepth;
+                    encoder.PushI32(target);
+                    encoder.PushI32(depth);
+                    break;
+                }
+                case 3:
+                    if (reaction->fUserDefined) {
+                        encoder.PushI32(reaction->iCorrosionRate);
+                        encoder.PushI32(100);
+                        encoder.PushBool(true);
+                        encoder.PushI32(reaction->iCorrosionRate);
+                    } else {
+                        if (pxs_material < 0 || landscape_material < 0) {
+                            error = "builtin corrode reaction has a sky material operand";
+                            return false;
+                        }
+                        encoder.PushI32(materials.Map[pxs_material].Corrosive);
+                        encoder.PushI32(materials.Map[landscape_material].Corrode);
+                        encoder.PushBool(false);
+                        encoder.PushI32(0);
+                    }
+                    break;
+                case 6: {
+                    if (!reaction->fUserDefined) {
+                        error = "script material reaction is not marked user-defined";
+                        return false;
+                    }
+                    const char *function = reaction->ScriptFunc.getData();
+                    const size_t function_length = reaction->ScriptFunc.getLength();
+                    if (!encoder.PushBytes(
+                            reinterpret_cast<const uint8_t *>(function),
+                            function_length,
+                            "material reaction script function",
+                            error)) {
+                        return false;
+                    }
+                    encoder.PushBool(reaction->pScriptFunc != nullptr);
+                    break;
+                }
+                default: break;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+bool CollectSurface8State(
+    const C4Landscape &landscape,
+    LandscapeSnapshotBuffer &buffer,
+    std::string &error) {
+    auto &snapshot = buffer.snapshot;
+    std::fill_n(snapshot.pix2mat, 256, -1);
+    snapshot.width = landscape.Width;
+    snapshot.height = landscape.Height;
+    if (landscape.Width < 0 || landscape.Height < 0) {
+        error = std::format(
+            "landscape dimensions are {}x{}",
+            landscape.Width,
+            landscape.Height);
+        return false;
+    }
+
+    const CSurface8 *surface =
+        RustEngineLandscapeValidationAccess::Surface8(landscape);
+    if (surface) {
+        if (surface->Wdt <= 0 || surface->Hgt <= 0) {
+            error = std::format(
+                "landscape Surface8 has invalid dimensions {}x{}",
+                surface->Wdt,
+                surface->Hgt);
+            return false;
+        }
+        if (surface->Pitch < surface->Wdt) {
+            error = std::format(
+                "landscape Surface8 pitch {} is smaller than width {}",
+                surface->Pitch,
+                surface->Wdt);
+            return false;
+        }
+        if (!surface->Bits) {
+            error = "landscape Surface8 has dimensions but no pixel storage";
+            return false;
+        }
+        size_t storage_length = 0;
+        if (!CheckedProduct(
+                static_cast<size_t>(surface->Pitch),
+                static_cast<size_t>(surface->Hgt),
+                storage_length)) {
+            error = "landscape Surface8 storage dimensions overflow";
+            return false;
+        }
+        buffer.surface8.assign(surface->Bits, surface->Bits + storage_length);
+        snapshot.surface_width = surface->Wdt;
+        snapshot.surface_height = surface->Hgt;
+        snapshot.pitch = surface->Pitch;
+        snapshot.surface_clip_x = surface->ClipX;
+        snapshot.surface_clip_y = surface->ClipY;
+        snapshot.surface_clip_x2 = surface->ClipX2;
+        snapshot.surface_clip_y2 = surface->ClipY2;
+
+        // Pix2* is not initialized by C4Landscape::Default. It becomes live
+        // together with Surface8 during landscape initialization.
+        std::copy_n(
+            RustEngineLandscapeValidationAccess::Pix2Mat(landscape),
+            256,
+            snapshot.pix2mat);
+        std::copy_n(
+            RustEngineLandscapeValidationAccess::Pix2Dens(landscape),
+            256,
+            snapshot.pix2dens);
+        std::copy_n(
+            RustEngineLandscapeValidationAccess::Pix2Place(landscape),
+            256,
+            snapshot.pix2place);
+        std::copy_n(landscape.MatCount, C4MaxMaterial, snapshot.mat_count);
+        std::copy_n(
+            landscape.EffectiveMatCount,
+            C4MaxMaterial,
+            snapshot.effective_mat_count);
+    }
+
+    snapshot.map_width = landscape.MapWidth;
+    snapshot.map_height = landscape.MapHeight;
+    if (landscape.MapWidth < 0 || landscape.MapHeight < 0) {
+        error = std::format(
+            "landscape retained Map dimensions are {}x{}",
+            landscape.MapWidth,
+            landscape.MapHeight);
+        return false;
+    }
+    if (landscape.Map) {
+        if (landscape.Map->Wdt <= 0 || landscape.Map->Hgt <= 0) {
+            error = std::format(
+                "landscape Map surface has invalid dimensions {}x{}",
+                landscape.Map->Wdt,
+                landscape.Map->Hgt);
+            return false;
+        }
+        if (landscape.Map->Pitch < landscape.Map->Wdt) {
+            error = std::format(
+                "landscape Map pitch {} is smaller than width {}",
+                landscape.Map->Pitch,
+                landscape.Map->Wdt);
+            return false;
+        }
+        if (!landscape.Map->Bits) {
+            error = "landscape Map has dimensions but no pixel storage";
+            return false;
+        }
+        size_t storage_length = 0;
+        if (!CheckedProduct(
+                static_cast<size_t>(landscape.Map->Pitch),
+                static_cast<size_t>(landscape.Map->Hgt),
+                storage_length)) {
+            error = "landscape Map storage dimensions overflow";
+            return false;
+        }
+        buffer.map.assign(
+            landscape.Map->Bits,
+            landscape.Map->Bits + storage_length);
+        snapshot.map_surface_width = landscape.Map->Wdt;
+        snapshot.map_surface_height = landscape.Map->Hgt;
+        snapshot.map_pitch = landscape.Map->Pitch;
+        snapshot.map_clip_x = landscape.Map->ClipX;
+        snapshot.map_clip_y = landscape.Map->ClipY;
+        snapshot.map_clip_x2 = landscape.Map->ClipX2;
+        snapshot.map_clip_y2 = landscape.Map->ClipY2;
+    }
+
+    snapshot.pix_cnt_pitch =
+        RustEngineLandscapeValidationAccess::PixCntPitch(landscape);
+    const uint8_t *pix_cnt =
+        RustEngineLandscapeValidationAccess::PixCnt(landscape);
+    if (!pix_cnt) {
+        if (snapshot.pix_cnt_pitch != 0) {
+            error = std::format(
+                "landscape PixCnt is null with pitch {}",
+                snapshot.pix_cnt_pitch);
+            return false;
+        }
+    } else {
+        const int32_t expected_pitch = (landscape.Height + 14) / 15;
+        if (snapshot.pix_cnt_pitch != expected_pitch || expected_pitch <= 0) {
+            error = std::format(
+                "landscape PixCnt pitch {} does not match height-derived {}",
+                snapshot.pix_cnt_pitch,
+                expected_pitch);
+            return false;
+        }
+        const size_t columns =
+            (static_cast<size_t>(landscape.Width) + 16) / 17;
+        size_t pix_cnt_length = 0;
+        if (!CheckedProduct(
+                columns,
+                static_cast<size_t>(snapshot.pix_cnt_pitch),
+                pix_cnt_length)) {
+            error = "landscape PixCnt dimensions overflow";
+            return false;
+        }
+        buffer.pix_cnt.assign(pix_cnt, pix_cnt + pix_cnt_length);
+    }
+    return true;
+}
+
+bool AppendMaterialCrossmapEntry(
+    std::vector<uint8_t> &entries,
+    int32_t value,
+    int32_t material,
+    const char *field,
+    std::string &error) {
+    if (value < 0 || value > std::numeric_limits<uint8_t>::max()) {
+        error = std::format(
+            "material {} {} cross-map value {} is outside u8",
+            material,
+            field,
+            value);
+        return false;
+    }
+    entries.push_back(static_cast<uint8_t>(value));
+    return true;
+}
+
+bool CollectMaterialAndTextureState(
+    C4Game &game,
+    LandscapeSnapshotBuffer &buffer,
+    std::string &error) {
+    auto &snapshot = buffer.snapshot;
+    std::fill_n(
+        snapshot.in_mat_convert_to,
+        LC_ENGINE_RUNTIME_LANDSCAPE_MATERIAL_CAPACITY,
+        -1);
+    for (auto &entry : snapshot.texmap) {
+        entry.material_index = -1;
+    }
+
+    if (game.Material.Num < 0 ||
+        game.Material.Num >
+            static_cast<int32_t>(LC_ENGINE_RUNTIME_LANDSCAPE_MATERIAL_CAPACITY)) {
+        error = std::format(
+            "material count {} is outside 0..{}",
+            game.Material.Num,
+            LC_ENGINE_RUNTIME_LANDSCAPE_MATERIAL_CAPACITY);
+        return false;
+    }
+    if (game.Material.Num != 0 && !game.Material.Map) {
+        error = "material map has a nonzero count but no entries";
+        return false;
+    }
+    snapshot.material_count = game.Material.Num;
+    buffer.default_mat_tex.reserve(static_cast<size_t>(game.Material.Num));
+    for (int32_t index = 0; index < game.Material.Num; ++index) {
+        const C4Material &material = game.Material.Map[index];
+        snapshot.in_mat_convert_to[index] = material.InMatConvertTo;
+        if (material.InMatConvertTo < -1 ||
+            material.InMatConvertTo >= game.Material.Num) {
+            error = std::format(
+                "material {} InMatConvertTo {} is outside -1..{}",
+                index,
+                material.InMatConvertTo,
+                game.Material.Num - 1);
+            return false;
+        }
+        if (material.DefaultMatTex < 0 ||
+            material.DefaultMatTex > std::numeric_limits<uint8_t>::max()) {
+            error = std::format(
+                "material {} DefaultMatTex {} is outside u8",
+                index,
+                material.DefaultMatTex);
+            return false;
+        }
+        buffer.default_mat_tex.push_back(
+            static_cast<uint8_t>(material.DefaultMatTex));
+        if (material.sBlastShiftTo.getLength() &&
+            !AppendMaterialCrossmapEntry(
+                buffer.material_crossmap,
+                material.BlastShiftTo,
+                index,
+                "BlastShiftTo",
+                error)) {
+            return false;
+        }
+        if (material.sBelowTempConvertTo.getLength() &&
+            !AppendMaterialCrossmapEntry(
+                buffer.material_crossmap,
+                material.BelowTempConvertTo,
+                index,
+                "BelowTempConvertTo",
+                error)) {
+            return false;
+        }
+        if (material.sAboveTempConvertTo.getLength() &&
+            !AppendMaterialCrossmapEntry(
+                buffer.material_crossmap,
+                material.AboveTempConvertTo,
+                index,
+                "AboveTempConvertTo",
+                error)) {
+            return false;
+        }
+    }
+
+    if (!EncodeMaterialBehaviorState(
+            game.Material,
+            buffer.material_behavior_state,
+            error) ||
+        !EncodeMaterialReactionState(
+            game.Material,
+            buffer.material_reaction_state,
+            error)) {
+        return false;
+    }
+
+    snapshot.texmap_initialized =
+        RustEngineLandscapeValidationAccess::TexMapInitialized(game.TextureMap)
+        ? 1u
+        : 0u;
+    snapshot.texmap_entries_added = game.TextureMap.fEntriesAdded ? 1u : 0u;
+    snapshot.texmap_overload_materials =
+        RustEngineLandscapeValidationAccess::TexMapOverloadMaterials(game.TextureMap)
+        ? 1u
+        : 0u;
+    snapshot.texmap_overload_textures =
+        RustEngineLandscapeValidationAccess::TexMapOverloadTextures(game.TextureMap)
+        ? 1u
+        : 0u;
+    for (int32_t index = 0; index < C4M_MaxTexIndex; ++index) {
+        const C4TexMapEntry *entry = game.TextureMap.GetEntry(index);
+        if (!entry || entry->isNull()) {
+            continue;
+        }
+        auto &raw = snapshot.texmap[index];
+        raw.present = 1;
+        raw.material_index = entry->GetMaterialIndex();
+        if (!BoundedCStringBytes(
+                entry->GetMaterialName(),
+                C4M_MaxName + 1,
+                buffer.texmap_material_names[index],
+                std::format("texture-map entry {} material", index),
+                error)) {
+            return false;
+        }
+        if (const char *texture_name = entry->GetTextureName()) {
+            raw.texture_name_present = 1;
+            if (!BoundedCStringBytes(
+                    texture_name,
+                    C4M_MaxName + 1,
+                    buffer.texmap_texture_names[index],
+                    std::format("texture-map entry {} texture", index),
+                    error)) {
+                return false;
+            }
+        }
+    }
+
+    return EncodeTextureInventory(
+        game.TextureMap,
+        buffer.texture_inventory,
+        error);
+}
