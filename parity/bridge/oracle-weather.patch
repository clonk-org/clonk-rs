+bool BoundedCStringBytes(
+    const char *value,
+    size_t capacity,
+    std::vector<uint8_t> &bytes,
+    const std::string &label,
+    std::string &error) {
+    if (!value) {
+        error = label + " is null";
+        return false;
+    }
+    size_t length = 0;
+    while (length < capacity && value[length] != '\0') {
+        ++length;
+    }
+    if (length == capacity) {
+        error = std::format("{} is not NUL-terminated within {} bytes", label, capacity);
+        return false;
+    }
+    bytes.assign(
+        reinterpret_cast<const uint8_t *>(value),
+        reinterpret_cast<const uint8_t *>(value) + length);
+    return true;
+}
