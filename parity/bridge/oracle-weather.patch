+bool CollectSolidMaskState(
+    LandscapeSnapshotBuffer &buffer,
+    std::string &error) {
+    std::vector<const C4SolidMask *> masks;
+    std::unordered_set<const C4SolidMask *> seen;
+    const C4SolidMask *previous = nullptr;
+    for (const C4SolidMask *mask = C4SolidMask::First; mask; mask = mask->Next) {
+        if (!seen.insert(mask).second) {
+            error = "solid-mask global list is cyclic";
+            return false;
+        }
+        if (mask->Prev != previous) {
+            error = "solid-mask global list has an inconsistent Prev link";
+            return false;
+        }
+        masks.push_back(mask);
+        previous = mask;
+    }
+    if (previous != C4SolidMask::Last ||
+        (C4SolidMask::First == nullptr) != (C4SolidMask::Last == nullptr)) {
+        error = "solid-mask global list has inconsistent first/last links";
+        return false;
+    }
+
+    std::unordered_set<int32_t> owner_numbers;
+    buffer.solid_mask_backing.reserve(masks.size());
+    buffer.solid_masks.reserve(masks.size());
+    for (size_t index = 0; index < masks.size(); ++index) {
+        const C4SolidMask &mask = *masks[index];
+        const C4Object *owner =
+            RustEngineLandscapeValidationAccess::SolidMaskOwner(mask);
+        if (!owner) {
+            error = std::format("solid mask {} has no owner", index);
+            return false;
+        }
+        if (owner->Number <= 0) {
+            error = std::format(
+                "solid mask {} owner has invalid object number {}",
+                index,
+                owner->Number);
+            return false;
+        }
+        if (!owner_numbers.insert(owner->Number).second) {
+            error = std::format(
+                "more than one solid mask is owned by object {}",
+                owner->Number);
+            return false;
+        }
+        if (owner->SolidMask.Wdt <= 0 || owner->SolidMask.Hgt <= 0) {
+            error = std::format(
+                "solid mask {} owner {} has source dimensions {}x{}",
+                index,
+                owner->Number,
+                owner->SolidMask.Wdt,
+                owner->SolidMask.Hgt);
+            return false;
+        }
+        size_t alpha_length = 0;
+        if (!CheckedProduct(
+                static_cast<size_t>(owner->SolidMask.Wdt),
+                static_cast<size_t>(owner->SolidMask.Hgt),
+                alpha_length)) {
+            error = std::format(
+                "solid mask {} owner {} source dimensions overflow",
+                index,
+                owner->Number);
+            return false;
+        }
+        const uint8_t *alpha =
+            RustEngineLandscapeValidationAccess::SolidMaskAlpha(mask);
+        if (!alpha) {
+            error = std::format(
+                "solid mask {} owner {} has no frozen alpha plane",
+                index,
+                owner->Number);
+            return false;
+        }
+        const int32_t pitch =
+            RustEngineLandscapeValidationAccess::SolidMaskPitch(mask);
+        if (pitch <= 0) {
+            error = std::format(
+                "solid mask {} owner {} has invalid MatBuffPitch {}",
+                index,
+                owner->Number,
+                pitch);
+            return false;
+        }
+        const int32_t attachment_count =
+            RustEngineLandscapeValidationAccess::SolidMaskAttachmentCount(mask);
+        if (attachment_count != 0) {
+            error = std::format(
+                "solid mask {} owner {} has {} pending attachments at the frame boundary",
+                index,
+                owner->Number,
+                attachment_count);
+            return false;
+        }
+
+        buffer.solid_mask_backing.emplace_back();
+        auto &backing = buffer.solid_mask_backing.back();
+        backing.alpha.assign(alpha, alpha + alpha_length);
+        if (const auto invalid = std::find_if(
+                backing.alpha.begin(),
+                backing.alpha.end(),
+                [](uint8_t value) { return value != 0x00 && value != 0xff; });
+            invalid != backing.alpha.end()) {
+            const size_t pixel =
+                static_cast<size_t>(invalid - backing.alpha.begin());
+            error = std::format(
+                "solid mask {} owner {} alpha ({}, {}) is {}, expected 0 or 255",
+                index,
+                owner->Number,
+                pixel % static_cast<size_t>(owner->SolidMask.Wdt),
+                pixel / static_cast<size_t>(owner->SolidMask.Wdt),
+                *invalid);
+            return false;
+        }
+
+        LcEngineRuntimeLandscapeSolidMaskSnapshot raw{};
+        raw.owner_id = static_cast<uint64_t>(owner->Number);
+        raw.source_x = owner->SolidMask.x;
+        raw.source_y = owner->SolidMask.y;
+        raw.source_width = owner->SolidMask.Wdt;
+        raw.source_height = owner->SolidMask.Hgt;
+        raw.source_target_x = owner->SolidMask.tx;
+        raw.source_target_y = owner->SolidMask.ty;
+        raw.mat_buff_pitch = pitch;
+        raw.attachment_count = 0;
+        raw.mask_put =
+            RustEngineLandscapeValidationAccess::SolidMaskPut(mask) ? 1u : 0u;
+        if (raw.mask_put) {
+            const C4TargetRect &put =
+                RustEngineLandscapeValidationAccess::SolidMaskPutRect(mask);
+            raw.put_x = put.x;
+            raw.put_y = put.y;
+            raw.put_width = put.Wdt;
+            raw.put_height = put.Hgt;
+            raw.put_target_x = put.tx;
+            raw.put_target_y = put.ty;
+            raw.put_rotation =
+                RustEngineLandscapeValidationAccess::SolidMaskPutRotation(mask);
+            if (put.Wdt > 0 && put.Hgt > 0) {
+                if (put.tx < 0 || put.ty < 0 ||
+                    static_cast<int64_t>(put.tx) + put.Wdt > pitch ||
+                    static_cast<int64_t>(put.ty) + put.Hgt > pitch) {
+                    error = std::format(
+                        "solid mask {} owner {} put window [{},{},{}x{}] exceeds MatBuffPitch {}",
+                        index,
+                        owner->Number,
+                        put.tx,
+                        put.ty,
+                        put.Wdt,
+                        put.Hgt,
+                        pitch);
+                    return false;
+                }
+                const uint8_t *background =
+                    RustEngineLandscapeValidationAccess::SolidMaskBackground(mask);
+                if (!background) {
+                    error = std::format(
+                        "solid mask {} owner {} is put but has no background plane",
+                        index,
+                        owner->Number);
+                    return false;
+                }
+                size_t background_length = 0;
+                if (!CheckedProduct(
+                        static_cast<size_t>(put.Wdt),
+                        static_cast<size_t>(put.Hgt),
+                        background_length)) {
+                    error = std::format(
+                        "solid mask {} owner {} put dimensions overflow",
+                        index,
+                        owner->Number);
+                    return false;
+                }
+                backing.background.reserve(background_length);
+                for (int32_t y = 0; y < put.Hgt; ++y) {
+                    const size_t offset =
+                        static_cast<size_t>(put.ty + y) *
+                            static_cast<size_t>(pitch) +
+                        static_cast<size_t>(put.tx);
+                    backing.background.insert(
+                        backing.background.end(),
+                        background + offset,
+                        background + offset + put.Wdt);
+                }
+            }
+        }
+        buffer.solid_masks.push_back(raw);
+    }
+    return true;
+}
