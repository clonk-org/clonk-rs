+bool ApplyLandscapeFaultInjection(
+    LandscapeSnapshotBuffer &buffer,
+    std::string &error) {
+    const char *fault =
+        std::getenv("LC_RUST_ENGINE_RUNTIME_LANDSCAPE_FAULT");
+    if (!fault || std::strcmp(fault, "surface8") != 0) {
+        return true;
+    }
+    if (buffer.surface8.empty()) {
+        error =
+            "landscape fault surface8 requested but the copied Surface8 payload is absent";
+        return false;
+    }
+    buffer.surface8[0] ^= 1u;
+    return true;
+}
