+const uint8_t *DataOrNull(const std::vector<uint8_t> &bytes) {
+    return bytes.empty() ? nullptr : bytes.data();
+}
+
+void WireLandscapeSnapshot(LandscapeSnapshotBuffer &buffer) {
+    auto &snapshot = buffer.snapshot;
+    snapshot.surface8 = DataOrNull(buffer.surface8);
+    snapshot.surface8_len = buffer.surface8.size();
+    snapshot.map = DataOrNull(buffer.map);
+    snapshot.map_len = buffer.map.size();
+    snapshot.default_mat_tex = DataOrNull(buffer.default_mat_tex);
+    snapshot.default_mat_tex_len = buffer.default_mat_tex.size();
+    snapshot.material_crossmap = DataOrNull(buffer.material_crossmap);
+    snapshot.material_crossmap_len = buffer.material_crossmap.size();
+    snapshot.texture_inventory = DataOrNull(buffer.texture_inventory);
+    snapshot.texture_inventory_len = buffer.texture_inventory.size();
+    snapshot.map_creator_state = DataOrNull(buffer.map_creator_state);
+    snapshot.map_creator_state_len = buffer.map_creator_state.size();
+    snapshot.material_reaction_state = DataOrNull(buffer.material_reaction_state);
+    snapshot.material_reaction_state_len = buffer.material_reaction_state.size();
+    snapshot.material_behavior_state = DataOrNull(buffer.material_behavior_state);
+    snapshot.material_behavior_state_len = buffer.material_behavior_state.size();
+    snapshot.pxs_state = DataOrNull(buffer.pxs_state);
+    snapshot.pxs_state_len = buffer.pxs_state.size();
+    snapshot.mass_mover_state = DataOrNull(buffer.mass_mover_state);
+    snapshot.mass_mover_state_len = buffer.mass_mover_state.size();
+    snapshot.pix_cnt = DataOrNull(buffer.pix_cnt);
+    snapshot.pix_cnt_len = buffer.pix_cnt.size();
+
+    for (size_t index = 0; index < buffer.solid_masks.size(); ++index) {
+        auto &raw = buffer.solid_masks[index];
+        const auto &backing = buffer.solid_mask_backing[index];
+        raw.alpha = DataOrNull(backing.alpha);
+        raw.alpha_len = backing.alpha.size();
+        raw.background = DataOrNull(backing.background);
+        raw.background_len = backing.background.size();
+    }
+    snapshot.solid_masks = buffer.solid_masks.empty()
+        ? nullptr
+        : buffer.solid_masks.data();
+    snapshot.solid_mask_count = buffer.solid_masks.size();
+
+    for (size_t index = 0;
+         index < LC_ENGINE_RUNTIME_LANDSCAPE_TEXMAP_CAPACITY;
+         ++index) {
+        auto &entry = snapshot.texmap[index];
+        if (!entry.present) {
+            continue;
+        }
+        entry.material_name = DataOrNull(buffer.texmap_material_names[index]);
+        entry.material_name_len = buffer.texmap_material_names[index].size();
+        if (entry.texture_name_present) {
+            entry.texture_name = DataOrNull(buffer.texmap_texture_names[index]);
+            entry.texture_name_len = buffer.texmap_texture_names[index].size();
+        }
+    }
+}
