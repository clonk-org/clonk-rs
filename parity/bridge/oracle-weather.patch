+bool CollectLandscapeSnapshot(
+    C4Game &game,
+    LandscapeSnapshotBuffer &buffer,
+    std::string &error) {
+    auto &snapshot = buffer.snapshot;
+    snapshot.abi_version = LC_ENGINE_RUNTIME_LANDSCAPE_ABI_VERSION;
+    snapshot.struct_size = sizeof(snapshot);
+
+    if (!CollectSurface8State(game.Landscape, buffer, error) ||
+        !CollectMaterialAndTextureState(game, buffer, error) ||
+        !CollectSolidMaskState(buffer, error) ||
+        !EncodePxsState(game.PXS, buffer.pxs_state, error) ||
+        !EncodeMassMoverState(
+            game.MassMover,
+            buffer.mass_mover_state,
+            error)) {
+        return false;
+    }
+
+    snapshot.mode = game.Landscape.Mode;
+    snapshot.map_seed = game.Landscape.MapSeed;
+    snapshot.map_zoom = game.Landscape.MapZoom;
+    snapshot.scan_x = game.Landscape.ScanX;
+    snapshot.scan_speed = game.Landscape.ScanSpeed;
+    snapshot.left_open = game.Landscape.LeftOpen;
+    snapshot.right_open = game.Landscape.RightOpen;
+    snapshot.gravity_raw = game.Landscape.Gravity.val;
+    snapshot.modulation = game.Landscape.Modulation;
+    snapshot.vehicle_material = MVehic;
+    snapshot.tunnel_material = MTunnel;
+    snapshot.water_material = MWater;
+    snapshot.snow_material = MSnow;
+    snapshot.granite_material = MGranite;
+    snapshot.vehicle_pixel = MCVehic;
+    snapshot.no_scan = game.Landscape.NoScan ? 1u : 0u;
+    snapshot.top_open = game.Landscape.TopOpen ? 1u : 0u;
+    snapshot.bottom_open = game.Landscape.BottomOpen ? 1u : 0u;
+    snapshot.shade_materials = game.Landscape.ShadeMaterials ? 1u : 0u;
+    snapshot.map_changed = game.Landscape.fMapChanged ? 1u : 0u;
+
+    if (game.Landscape.pMapCreator &&
+        !EncodeMapCreatorState(
+            game,
+            *game.Landscape.pMapCreator,
+            buffer.map_creator_state,
+            error)) {
+        return false;
+    }
+    if (!ApplyLandscapeFaultInjection(buffer, error)) {
+        return false;
+    }
+    WireLandscapeSnapshot(buffer);
+    return true;
+}
