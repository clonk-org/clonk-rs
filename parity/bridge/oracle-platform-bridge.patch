-std::optional<std::string> Fetch(StringGetter getter) {
-    return TakeString(getter());
+// C4ConfigGeneral::DeterminePaths runs inside C4Config::Load, before
+// LogSystem.OpenLog, so the report goes to stderr where a differential can
+// read it. LC_RUST_PLATFORM_FAULT=<getter name> discards that getter's answer
+// after freeing it, which is the only way to reach the incomplete-set path:
+// the pinned contract has C++ fall back to its own paths the moment one
+// answer is null.
+std::optional<std::string> Fetch(StringGetter getter, const char *name) {
+    auto value = TakeString(getter());
+    if (const char *fault = std::getenv("LC_RUST_PLATFORM_FAULT"); fault && std::string_view{fault} == name) {
+        value.reset();
+    }
+    if (!value) {
+        std::fprintf(stderr, "Rust platform paths unavailable (%s returned null); legacy paths used\n", name);
+    }
+    return value;
 }
 
 } // namespace
