+C4Rect Tabular::GetPresentationTabRect(int32_t index) const
+{
+	const C4Rect bounds = GetScreenBounds();
+	const bool left = eTabPos == tbLeft;
+	const int32_t x0 = bounds.x + GetLeftSize();
+	const int32_t y0 = bounds.y + GetTopSize();
+	int32_t offset = (left ? y0 : x0) + iSheetOff;
+	if (fScrollingLeft) offset -= iCaptionScrollPos + GetTopSize();
+	int32_t current = 0;
+	for (Sheet *sheet = static_cast<Sheet *>(const_cast<Tabular *>(this)->GetFirst()); sheet; sheet = static_cast<Sheet *>(sheet->GetNext()), ++current)
+	{
+		int32_t width, height;
+		sheet->GetCaptionSize(&width, &height, HasLargeCaptions(), sheet == pActiveSheet, pfctClip, pfctIcons, pSheetCaptionFont);
+		const int32_t drawX = left ? x0 - GetLeftSize() + 10 : offset + (width + iSheetSpacing) / 2;
+		const int32_t drawY = left ? offset + iSheetSpacing / 2 : y0 - GetTopSize() + 2;
+		if (current == index)
+			return C4Rect(drawX, drawY, pfctClip ? pfctClip->Wdt : width, pfctClip ? pfctClip->Hgt : height);
+		width += left ? 20 : iSheetSpacing;
+		height += left ? iSheetSpacing : 10;
+		offset += (left ? height : width) + 2;
+	}
+	return C4Rect();
+}
