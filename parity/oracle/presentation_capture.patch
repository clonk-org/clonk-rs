+		std::string Windows1252ToUtf8(const std::string_view text)
+		{
+			constexpr std::array<uint16_t, 32> controls{
+				0x20ac, 0, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
+				0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0, 0x017d, 0,
+				0, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
+				0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0, 0x017e, 0x0178};
+			std::string converted;
+			for (const unsigned char byte : text)
+			{
+				uint32_t codePoint = byte;
+				if (byte >= 0x80 && byte < 0xa0)
+				{
+					codePoint = controls[byte - 0x80];
+					if (!codePoint) CaptureFailure(std::format("layout text contains undefined Windows-1252 byte 0x{:02x}", byte));
+				}
+				if (codePoint < 0x80) converted.push_back(static_cast<char>(codePoint));
+				else if (codePoint < 0x800)
+				{
+					converted.push_back(static_cast<char>(0xc0 | (codePoint >> 6)));
+					converted.push_back(static_cast<char>(0x80 | (codePoint & 0x3f)));
+				}
+				else
+				{
+					converted.push_back(static_cast<char>(0xe0 | (codePoint >> 12)));
+					converted.push_back(static_cast<char>(0x80 | ((codePoint >> 6) & 0x3f)));
+					converted.push_back(static_cast<char>(0x80 | (codePoint & 0x3f)));
+				}
+			}
+			return converted;
+		}
+
+		std::string RectJson(const C4Rect &rect)
+		{
+			return std::format(R"({{"x":{},"y":{},"width":{},"height":{}}})",
+				rect.x, rect.y, std::max(rect.Wdt, 0), std::max(rect.Hgt, 0));
+		}
+
+		std::string ClonkJsonText(const std::string_view text)
+		{
+			// Capture mode has already validated the live language charset as CP1252.
+			return JsonEscape(Windows1252ToUtf8(text));
+		}
+	}
