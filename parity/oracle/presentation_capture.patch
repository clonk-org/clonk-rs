+	const C4Rect tab = GetPresentationTabRect(index);
+	CStdFont &font = pSheetCaptionFont ? *pSheetCaptionFont : (HasLargeCaptions() ? GetRes()->CaptionFont : GetRes()->TextFont);
+	int32_t width, height;
+	font.GetTextExtent(sheet->GetTitle(), width, height, true);
+	if (pfctClip && pfctIcons)
+	{
+		int32_t captionWidth, captionHeight;
+		sheet->GetCaptionSize(&captionWidth, &captionHeight, HasLargeCaptions(), sheet == pActiveSheet, pfctClip, pfctIcons, pSheetCaptionFont);
+		const int32_t centerX = tab.x + captionWidth / 2;
+		const int32_t centerY = tab.y + captionHeight / 2;
+		const int32_t textY = centerY - (pfctIcons->Hgt + 2 + font.GetLineHeight()) / 2 + pfctIcons->Hgt + 2;
+		return C4Rect(centerX - width / 2, textY, width, font.GetLineHeight());
