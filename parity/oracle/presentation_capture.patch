+std::string C4StartupPlrSelDlg::BuildPresentationLayoutTrace()
+{
+	// Player-mode topology mirrors C4StartupPlrSelDlg.cpp:545-583,636-656.
+	if (eMode != PSDM_Player) throw std::runtime_error("startup-player-selection capture requires player mode");
+	std::vector<C4PresentationCapture::LayoutElement> elements;
+	elements.push_back(C4PresentationCapture::Empty("startup/player-selection/background", "image", this, "super-resolved-startup-art"));
+	elements.push_back(C4PresentationCapture::Label("startup/player-selection/title", pFullscreenTitle));
+	elements.push_back(C4PresentationCapture::Empty("startup/player-selection/list", "listbox", pPlrListBox));
+	const C4Rect viewport = pPlrListBox->GetPresentationViewportBounds();
+	std::size_t visibleIndex = 0;
+	for (C4GUI::Element *element = pPlrListBox->GetFirst(); element; element = element->GetNext())
+	{
+		auto *item = dynamic_cast<ListItem *>(element);
+		if (!item || !C4PresentationCapture::Intersects(item->GetScreenBounds(), viewport)) continue;
+		const std::string base = std::format("startup/player-selection/list/items/{}", visibleIndex++);
+		auto *name = item->GetPresentationNameLabel();
+		elements.push_back(C4PresentationCapture::Text(base.c_str(), "list-item", item, name->GetText(), name->GetPresentationTextRect()));
+		elements.push_back(C4PresentationCapture::Empty((base + "/active").c_str(), "checkbox", item->GetPresentationCheckBox()));
+		elements.push_back(C4PresentationCapture::Empty((base + "/icon").c_str(), "picture", item->GetPresentationIcon()));
+		elements.push_back(C4PresentationCapture::Label((base + "/name").c_str(), name));
+	}
+	auto *scrollBar = pPlrListBox->GetPresentationScrollBar();
+	if (!scrollBar) throw std::runtime_error("player-selection list has no live scrollbar");
+	elements.push_back(C4PresentationCapture::Empty("startup/player-selection/list/scrollbar", "scrollbar", scrollBar));
+	elements.push_back(C4PresentationCapture::TextWindow("startup/player-selection/selection-info", pSelectionInfo));
+	elements.push_back(C4PresentationCapture::Empty("startup/player-selection/portrait", "picture", pPortraitPict));
+	elements.push_back(C4PresentationCapture::Button("startup/player-selection/buttons/back", btnBack));
+	elements.push_back(C4PresentationCapture::Button("startup/player-selection/buttons/new-player", btnNew));
+	elements.push_back(C4PresentationCapture::Button("startup/player-selection/buttons/activate", btnActivatePlr));
+	elements.push_back(C4PresentationCapture::Button("startup/player-selection/buttons/delete", btnDelete));
+	elements.push_back(C4PresentationCapture::Button("startup/player-selection/buttons/properties", btnProperties));
+	elements.push_back(C4PresentationCapture::Button("startup/player-selection/buttons/crew", btnCrew));
+	return C4PresentationCapture::Serialize("startup-player-selection", elements);
+}
