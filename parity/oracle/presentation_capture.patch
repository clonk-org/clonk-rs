+	struct FileRecord
+	{
+		std::filesystem::path path;
+		std::string relativePath;
+		std::string sha256;
+		uintmax_t size;
+	};
+
+	FileRecord ReadFileRecord(const std::filesystem::path &path, std::string relativePath)
+	{
+		std::ifstream input{path, std::ios::binary};
+		if (!input) CaptureFailure(std::format("could not open {} for hashing", path.string()));
+		Sha256 hash;
+		std::array<uint8_t, 64 * 1024> buffer{};
+		while (input)
+		{
+			input.read(reinterpret_cast<char *>(buffer.data()), static_cast<std::streamsize>(buffer.size()));
+			const auto count = input.gcount();
+			if (count > 0) hash.Update(std::span<const uint8_t>{buffer.data(), static_cast<std::size_t>(count)});
+		}
+		if (!input.eof()) CaptureFailure(std::format("could not read {} for hashing", path.string()));
+		std::error_code error;
+		const uintmax_t size = std::filesystem::file_size(path, error);
+		if (error) CaptureFailure(std::format("could not stat {}: {}", path.string(), error.message()));
+		return {path, std::move(relativePath), hash.Finish(), size};
+	}
+
+	std::filesystem::path RequireRegularFile(const std::filesystem::path &path, const char *label)
+	{
+		std::error_code error;
+		const auto status = std::filesystem::symlink_status(path, error);
+		if (error || status.type() != std::filesystem::file_type::regular)
+			CaptureFailure(std::format("{} is not a regular, non-symlink file: {}", label, path.string()));
+		const auto canonical = std::filesystem::canonical(path, error);
+		if (error) CaptureFailure(std::format("could not resolve {} {}: {}", label, path.string(), error.message()));
+		return canonical;
+	}
+
+	std::filesystem::path RequireDirectory(const std::filesystem::path &path, const char *label)
+	{
+		std::error_code error;
+		const auto status = std::filesystem::symlink_status(path, error);
+		if (error || status.type() != std::filesystem::file_type::directory)
+			CaptureFailure(std::format("{} is not a directory: {}", label, path.string()));
+		const auto canonical = std::filesystem::canonical(path, error);
+		if (error) CaptureFailure(std::format("could not resolve {} {}: {}", label, path.string(), error.message()));
+		return canonical;
+	}
+
+	void RequireAbsent(const std::filesystem::path &path, const char *label)
+	{
+		std::error_code error;
+		const auto status = std::filesystem::symlink_status(path, error);
+		if (error && error != std::errc::no_such_file_or_directory)
+			CaptureFailure(std::format("could not inspect {} {}: {}", label, path.string(), error.message()));
+		if (!error && status.type() != std::filesystem::file_type::not_found)
+			CaptureFailure(std::format("{} must be absent before capture: {}", label, path.string()));
+	}
+
+	std::string DirectoryManifestSha256(const std::filesystem::path &path, const char *label)
+	{
+		const auto root = RequireDirectory(path, label);
+		std::vector<std::pair<std::string, std::filesystem::path>> files;
+		std::error_code error;
+		for (std::filesystem::recursive_directory_iterator iterator{root, error}, end; iterator != end; iterator.increment(error))
+		{
+			if (error) CaptureFailure(std::format("could not traverse {} {}: {}", label, root.string(), error.message()));
+			const auto status = iterator->symlink_status(error);
+			if (error) CaptureFailure(std::format("could not inspect {} entry {}: {}", label, iterator->path().string(), error.message()));
+			if (status.type() == std::filesystem::file_type::directory) continue;
+			if (status.type() != std::filesystem::file_type::regular)
+				CaptureFailure(std::format("{} contains a non-regular or symlink entry: {}", label, iterator->path().string()));
+			const auto relative = std::filesystem::relative(iterator->path(), root, error);
+			if (error || relative.empty()) CaptureFailure(std::format("could not derive a relative path for {} entry {}", label, iterator->path().string()));
+			const auto relativeString = relative.generic_string();
+			if (relativeString.starts_with("../") || relativeString.find("/../") != std::string::npos)
+				CaptureFailure(std::format("{} entry escaped its root: {}", label, relativeString));
+			files.emplace_back(relativeString, iterator->path());
+		}
+		if (error) CaptureFailure(std::format("could not traverse {} {}: {}", label, root.string(), error.message()));
+		if (files.empty()) CaptureFailure(std::format("{} is empty: {}", label, root.string()));
+		std::ranges::sort(files, {}, &std::pair<std::string, std::filesystem::path>::first);
+		Sha256 manifest;
+		for (const auto &[relative, file] : files)
+		{
+			const std::string line = ReadFileRecord(file, "").sha256 + "  " + relative + '\n';
+			manifest.Update(std::span<const uint8_t>{reinterpret_cast<const uint8_t *>(line.data()), line.size()});
+		}
+		return manifest.Finish();
+	}
+
+	std::string Sha256Text(const std::string_view text)
+	{
+		Sha256 hash;
+		hash.Update(std::span<const uint8_t>{reinterpret_cast<const uint8_t *>(text.data()), text.size()});
+		return hash.Finish();
+	}
