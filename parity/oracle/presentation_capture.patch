+std::vector<std::pair<std::string, C4Rect>> TextWindow::GetPresentationLines() const
+{
+	std::vector<std::pair<std::string, C4Rect>> result;
+	if (!pClientWindow || !pLogBuffer) return result;
+	const C4Rect logBounds = pLogBuffer->GetScreenBounds();
+	const C4Rect clipBounds = pClientWindow->GetScreenBounds();
+	int32_t y = logBounds.y;
+	int32_t index = 0;
+	const char *line;
+	CStdFont *font;
+	bool newParagraph;
+	while (line = pLogBuffer->Lines.GetLine(index, &font, nullptr, &newParagraph))
+	{
+		const int32_t lineHeight = font->GetLineHeight();
+		if (newParagraph && index) y += lineHeight / 3;
+		if (y > clipBounds.y + clipBounds.Hgt - 1) break;
+		if (y >= clipBounds.y - lineHeight)
+		{
+			int32_t width, height;
+			font->GetTextExtent(line, width, height, pLogBuffer->fMarkup);
+			result.emplace_back(line, C4Rect(logBounds.x, y, width, lineHeight));
+		}
+		y += lineHeight;
+		++index;
+	}
+	return result;
+}
