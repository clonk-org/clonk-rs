+	elements.push_back(C4PresentationCapture::Label("startup/options/program/fair-crew/strong", takeFairCrew.template operator()<C4GUI::Label>("strong")));
+	elements.push_back(C4PresentationCapture::Empty("startup/options/program/fair-crew/slider", "scrollbar", takeFairCrew.template operator()<C4GUI::ScrollBar>("slider")));
