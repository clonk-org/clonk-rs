+		if (RuntimeCapture.mode == RuntimeMode::None || !RuntimeCapture.spec || RuntimeCapture.spec->stateFrame <= 0 || RuntimeCapture.simulationFrozen) return;
+		if (Game.FrameCounter < RuntimeCapture.spec->stateFrame) return;
