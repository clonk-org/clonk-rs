+	if (std::filesystem::exists(resolvedReceipt, pathError) || pathError)
+		CaptureFailure("capture receipt path already exists or cannot be inspected");
+	presentationCaptureReceiptPath = resolvedReceipt.string();
+
+	const auto configArgument = CommandLineValue("/config:");
+	if (!configArgument) CaptureFailure("presentation capture requires an explicit /config:<absolute-path> argument");
+	const std::filesystem::path configPath{*configArgument};
+	if (!configPath.is_absolute()) CaptureFailure("presentation capture config path must be absolute");
+	const auto resolvedConfig = RequireRegularFile(configPath, "capture config");
+	if (resolvedConfig != inputDirectory / "cpp.config")
+		CaptureFailure("capture config must resolve exactly to candidate inputs/cpp.config");
+	if (ReadFileRecord(resolvedConfig, "").sha256 != ConfigSha256)
+		CaptureFailure("capture config digest differs from the tracked canonical native config");
+	presentationCaptureConfigPath = resolvedConfig.string();
+
+	if (!SEqual(Config.General.Participants, "Presentation.c4p"))
+		CaptureFailure(std::format("capture config Participants must be exactly Presentation.c4p, got '{}'", Config.General.Participants));
+	const auto workingDirectory = RequireDirectory(std::filesystem::current_path(), "capture working directory");
+	if (workingDirectory != inputDirectory)
+		CaptureFailure("capture process working directory must be the candidate inputs directory");
+	const auto resolvedPlayer = RequireRegularFile(inputDirectory / "Presentation.c4p", "player fixture");
+	if (resolvedPlayer != inputDirectory / "Presentation.c4p")
+		CaptureFailure("player fixture must resolve exactly to inputs/Presentation.c4p");
+	if (ReadFileRecord(resolvedPlayer, "").sha256 != PlayerSha256)
+		CaptureFailure("player fixture digest differs from the tracked canonical player");
+	presentationCapturePlayerPath = resolvedPlayer.string();
+	const auto resolvedNetworkReferences = RequireRegularFile(inputDirectory / "network-references.json", "network references fixture");
+	if (resolvedNetworkReferences != inputDirectory / "network-references.json")
+		CaptureFailure("network references fixture must resolve exactly to inputs/network-references.json");
+	if (ReadFileRecord(resolvedNetworkReferences, "").sha256 != NetworkReferencesSha256)
+		CaptureFailure("network references fixture digest differs from the tracked completed-empty fixture");
+	presentationCaptureNetworkReferencesPath = resolvedNetworkReferences.string();
+	if (DirectoryManifestSha256(inputDirectory / "Graphics.c4g", "oracle Graphics.c4g") != OracleGraphicsManifestSha256)
+		CaptureFailure("oracle Graphics.c4g manifest differs from the pinned source tree");
+	if (DirectoryManifestSha256(inputDirectory / "System.c4g", "oracle System.c4g") != OracleSystemManifestSha256)
+		CaptureFailure("oracle System.c4g manifest differs from the pinned source tree");
+	if (presentationCaptureCase == "startup-scenario-selection" &&
+		DirectoryManifestSha256(inputDirectory / "Tutorial.c4f", "content Tutorial.c4f") != TutorialManifestSha256)
+		CaptureFailure("startup scenario content differs from the pinned content tree");
+	presentationCaptureBinaryPath = RequireRegularFile(Application.GetExecutablePath(), "capture binary").string();
+
+	const auto requiredLocale = [](const char *name, const char *expected)
+	{
+		const char *actual = std::getenv(name);
+		if (!actual || std::string_view{actual} != expected)
+			CaptureFailure(std::format("{} must be exactly {}", name, expected));
+	};
+	requiredLocale("LANG", "C");
+	requiredLocale("LC_ALL", "C");
+	requiredLocale("TZ", "UTC");
+	if (!SEqual(Config.General.Language, "US") || !SEqual(Config.General.LanguageEx, "US") ||
+		!SEqual(C4Config::GetCharsetCodeName(Config.General.LanguageCharset), "CP1252"))
+		CaptureFailure("capture config locale must resolve to US / CP1252");
+
+	Game.pGUI->SetRenderMouseCursor(false);
+	presentationCaptureStableRenderOrdinal = 0;
+	fPresentationCaptureEnabled = true;
+}
+
+void C4Startup::CapturePresentationFrameAfterRender()
+{
+	if (!fPresentationCaptureEnabled) return;
+	if (!pCurrDlg || !pCurrDlg->IsShown()) CaptureFailure("target startup dialog disappeared before capture");
+	if (Game.pGUI->GetTopDialog() != pCurrDlg)
+		CaptureFailure("an unexpected modal obscured the target startup dialog");
+	if (pCurrDlg->IsFading())
+	{
+		presentationCaptureStableRenderOrdinal = 0;
+		return;
+	}
+	if (auto *scenarioDialog = dynamic_cast<C4StartupScenSelDlg *>(pCurrDlg);
+		scenarioDialog && !scenarioDialog->IsPresentationCaptureReady())
+	{
+		presentationCaptureStableRenderOrdinal = 0;
+		return;
+	}
+	if (auto *networkDialog = dynamic_cast<C4StartupNetDlg *>(pCurrDlg);
+		networkDialog && !networkDialog->IsPresentationCaptureReady())
+	{
+		presentationCaptureStableRenderOrdinal = 0;
+		return;
+	}
+	if (++presentationCaptureStableRenderOrdinal < 2) return;
+	if (presentationCaptureStableRenderOrdinal != 2) CaptureFailure("capture render ordinal advanced past 2");
+	if (!Application.DDraw || !Application.DDraw->lpBack)
+		CaptureFailure("composed back buffer is unavailable");
+	if (Application.DDraw->lpBack->Wdt != CaptureWidth || Application.DDraw->lpBack->Hgt != CaptureHeight || Application.GetScale() != 1.0f)
+		CaptureFailure("actual composed back-buffer geometry differs from 1280x720 at scale 100");
+	if (RandomHold != CaptureSeed || RandomCount != 0 || SafeRandomSeed != CaptureSeed || SafeRandomCount != 0)
+		CaptureFailure(std::format("startup RNG contract drift: simulation seed={} calls={}, presentation seed={} calls={}",
+			RandomHold, RandomCount, SafeRandomSeed, SafeRandomCount));
+	if (!SafeRandomTrace.empty()) CaptureFailure("startup SafeRandom trace advanced despite its zero-call contract");
+	// Keep startup on the same empty direct-rand contract as runtime. The only
+	// native consumers are pinned at C4League.cpp:530, C4NetIO.cpp:2154/3296,
+	// and C4Texture.cpp:448-451.
+	if (!RawRandomAuditTrace.empty()) CaptureFailure("startup reached an unaudited direct native rand() consumer");
+	const std::string safeRandomTraceSha256 = Sha256Text(SafeRandomTrace);
+	if (!SEqual(Config.General.Language, "US") || !SEqual(C4Config::GetCharsetCodeName(Config.General.LanguageCharset), "CP1252"))
+		CaptureFailure("live capture locale drifted from primary language US / CP1252");
+
+	std::string layout;
+	try
+	{
+		if (auto *dialog = dynamic_cast<C4StartupMainDlg *>(pCurrDlg))
+			layout = dialog->BuildPresentationLayoutTrace();
+		else if (auto *dialog = dynamic_cast<C4StartupScenSelDlg *>(pCurrDlg))
+			layout = dialog->BuildPresentationLayoutTrace();
+		else if (auto *dialog = dynamic_cast<C4StartupNetDlg *>(pCurrDlg))
+			layout = dialog->BuildPresentationLayoutTrace();
+		else if (auto *dialog = dynamic_cast<C4StartupPlrSelDlg *>(pCurrDlg))
+			layout = dialog->BuildPresentationLayoutTrace();
+		else if (auto *dialog = dynamic_cast<C4StartupOptionsDlg *>(pCurrDlg))
+			layout = dialog->BuildPresentationLayoutTrace();
+		else if (auto *dialog = dynamic_cast<C4StartupAboutDlg *>(pCurrDlg))
+			layout = dialog->BuildPresentationLayoutTrace();
+		else CaptureFailure(std::format("{} resolved to an unsupported dialog type", presentationCaptureCase));
+	}
+	catch (const std::exception &error)
+	{
+		CaptureFailure(std::format("{} layout capture failed: {}", presentationCaptureCase, error.what()));
+	}
+	const std::filesystem::path outputDirectory{presentationCaptureOutputDirectory};
+	const auto pngPath = outputDirectory / (presentationCaptureCase + ".png");
+	const auto layoutPath = outputDirectory / (presentationCaptureCase + ".layout.json");
+	auto temporaryPng = pngPath;
+	temporaryPng += std::format(".tmp.{}", presentationCaptureNonce);
+	std::error_code outputError;
+	if (std::filesystem::exists(pngPath, outputError) || outputError || std::filesystem::exists(temporaryPng, outputError) || outputError)
+		CaptureFailure("capture PNG destination is not fresh");
+	if (!Application.DDraw->lpBack->SavePNG(temporaryPng.string().c_str(), false, !Config.Graphics.Shader, false, Application.GetScale()))
+		CaptureFailure("could not encode the composed pre-pageflip frame as PNG");
+	PromoteAtomic(temporaryPng, pngPath);
+	WriteAtomic(layoutPath, layout, presentationCaptureNonce);
+
+	const std::string artifactPrefix = presentationCaptureRunID + "/cpp/artifacts/";
+	const FileRecord png = ReadFileRecord(pngPath, artifactPrefix + pngPath.filename().string());
+	const FileRecord layoutRecord = ReadFileRecord(layoutPath, artifactPrefix + layoutPath.filename().string());
+	const FileRecord binary = ReadFileRecord(presentationCaptureBinaryPath, "");
+	const FileRecord config = ReadFileRecord(presentationCaptureConfigPath, "");
+	const FileRecord player = ReadFileRecord(presentationCapturePlayerPath, "");
+	const FileRecord networkReferences = ReadFileRecord(presentationCaptureNetworkReferencesPath, "");
+	const auto language = TextEncodingConverter.ClonkToUtf8<char>(Config.General.Language);
+	const std::string receipt = std::format(
+		R"({{"schema":"clonk-rs/presentation-engine-receipt/v2","run_id":"{}","launcher_nonce":"{}","engine":"cpp","producer":"legacyclonk-capture-patch-v1","case_id":"{}","binary_sha256":"{}","source_tree":"{}","content_tree":"{}","profile":"oracle-native","config_sha256":"{}","player_sha256":"{}","network_references_sha256":"{}","runtime_resources":{{"graphics":{{"tree":"{}","manifest_sha256":"{}"}},"system":{{"tree":"{}","manifest_sha256":"{}"}}}},"locale":{{"language":"{}","charset":"Windows-1252","lang":"C","lc_all":"C","tz":"UTC"}},"seeds":{{"simulation":{{"seed":587,"calls":0}},"presentation":{{"algorithm":"darwin-libc-rand-park-miller-v1","seed":587,"calls":0,"trace_sha256":"{}"}}}},"trigger":{{"id":"direct-startup-dialog"}},"scenario":{{"path":null,"content_tree":"{}"}},"frame":{{"checkpoint":"{}/fade-complete","number":2}},"artifacts":{{"png":{},"layout":{}}}}})",
+		JsonEscape(presentationCaptureRunID), presentationCaptureNonce, JsonEscape(presentationCaptureCase),
+		binary.sha256, OracleSourceTree, FixtureContentTree, config.sha256, player.sha256, networkReferences.sha256,
+		OracleGraphicsTree, OracleGraphicsManifestSha256, OracleSystemTree, OracleSystemManifestSha256, JsonEscape(language), safeRandomTraceSha256,
+		FixtureContentTree, JsonEscape(presentationCaptureCase), FileRecordJson(png), FileRecordJson(layoutRecord));
+	WriteAtomic(presentationCaptureReceiptPath, receipt, presentationCaptureNonce);
+	std::fprintf(stdout, "LegacyClonk presentation capture complete: %s render ordinal 2\n", presentationCaptureCase.c_str());
+	std::fflush(nullptr);
+	std::_Exit(EXIT_SUCCESS);
+}
+
+void C4Startup::PresentationCaptureAfterRender()
+{
+	if (pInstance) pInstance->CapturePresentationFrameAfterRender();
+}
