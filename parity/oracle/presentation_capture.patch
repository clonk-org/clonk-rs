+C4Rect CheckBox::GetPresentationTextRect() const
+{
+	const C4Rect bounds = GetScreenBounds();
+	CStdFont *font = pFont ? pFont : &(GetRes()->TextFont);
+	int32_t yOffset;
+	float zoom;
+	if (font->GetLineHeight() <= bounds.Hgt)
+	{
+		yOffset = std::max<int32_t>(bounds.Hgt - font->GetLineHeight(), 0) / 2;
+		zoom = 1.0f;
+	}
+	else
+	{
+		yOffset = 0;
+		zoom = static_cast<float>(bounds.Hgt) / std::max(font->GetLineHeight(), 1);
+	}
+	int32_t width, height;
+	font->GetTextExtent(sCaption.getData(), width, height, true);
+	return C4Rect(bounds.x + bounds.Hgt + C4GUI_CheckBoxLabelSpacing, bounds.y + yOffset,
+		static_cast<int32_t>(width * zoom), static_cast<int32_t>(font->GetLineHeight() * zoom));
+}
