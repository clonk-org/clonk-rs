+void C4StartupNetDlg::ApplyPresentationReferenceFixture()
+{
+	// The hash-bound fixture represents a successfully completed query with zero
+	// references. Drive the same completion callback as Ev_HTTP_Response without
+	// opening discovery or HTTP sockets.
+	if (Config.Network.MasterServerSignUp)
+		throw std::runtime_error("startup-network-browser fixture requires master-server lookup disabled");
+	if (GetDlgMode() != SNDM_GameList || pGameSelList->GetFirst())
+		throw std::runtime_error("startup-network-browser fixture requires an initially empty game-list page");
+	OnThreadEvent(Ev_HTTP_Response, std::any{});
+	pGameSelList->UpdateElementPositions();
+	if (pGameSelList->GetFirst() || pMasterserverClient)
+		throw std::runtime_error("completed-empty network fixture unexpectedly produced list entries");
+	fPresentationFixtureComplete = true;
+}
