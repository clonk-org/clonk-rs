+std::string C4StartupNetDlg::BuildPresentationLayoutTrace()
+{
+	// Game-list topology mirrors C4StartupNetDlg.cpp:631-728.
+	if (!IsPresentationCaptureReady() || GetDlgMode() != SNDM_GameList)
+		throw std::runtime_error("startup-network-browser capture is not in completed-empty game-list state");
+	if (!btnGameList || !btnChat)
+		throw std::runtime_error("startup-network-browser requires the Games and Chat mode controls");
+	std::vector<C4PresentationCapture::LayoutElement> elements;
+	elements.push_back(C4PresentationCapture::Empty("startup/network-browser/background", "image", this, "super-resolved-startup-art"));
+	elements.push_back(C4PresentationCapture::Label("startup/network-browser/title", pFullscreenTitle));
+	elements.push_back(C4PresentationCapture::Button("startup/network-browser/mode/games", btnGameList, "icon-button"));
+	elements.push_back(C4PresentationCapture::Button("startup/network-browser/mode/chat", btnChat, "icon-button"));
+	elements.push_back(C4PresentationCapture::Empty("startup/network-browser/content", "tabular", pMainTabular));
+	elements.push_back(C4PresentationCapture::Label("startup/network-browser/content/caption", pGameListLabel));
+	elements.push_back(C4PresentationCapture::Empty("startup/network-browser/list", "listbox", pGameSelList));
+	if (pGameSelList->GetFirst())
+		throw std::runtime_error("completed-empty network fixture contains an unexpected live row");
+	auto *scrollBar = pGameSelList->GetPresentationScrollBar();
+	if (!scrollBar) throw std::runtime_error("startup-network-browser list has no live scrollbar");
+	elements.push_back(C4PresentationCapture::Empty("startup/network-browser/list/scrollbar", "scrollbar", scrollBar));
+	elements.push_back(C4PresentationCapture::Label("startup/network-browser/join/label", pJoinAddressLabel));
+	elements.push_back(C4PresentationCapture::Edit("startup/network-browser/join/address", pJoinAddressEdt));
+	elements.push_back(C4PresentationCapture::Button("startup/network-browser/config/internet", btnInternet, "icon-button"));
+	elements.push_back(C4PresentationCapture::Button("startup/network-browser/config/record", btnRecord, "icon-button"));
+	elements.push_back(C4PresentationCapture::Button("startup/network-browser/buttons/back", pBackButton));
+	elements.push_back(C4PresentationCapture::Button("startup/network-browser/buttons/reload", btnRefresh));
+	elements.push_back(C4PresentationCapture::Button("startup/network-browser/buttons/join", btnJoin));
+	elements.push_back(C4PresentationCapture::Button("startup/network-browser/buttons/new-game", pNewGameButton));
+	return C4PresentationCapture::Serialize("startup-network-browser", elements);
+}
