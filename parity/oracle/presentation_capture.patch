+	elements.push_back(C4PresentationCapture::Button("startup/options/program/advanced", take.template operator()<C4GUI::Button>("advanced")));
+	if (child) throw std::runtime_error("startup-options Program topology has unexpected children");
+	return C4PresentationCapture::Serialize("startup-options", elements);
+}
