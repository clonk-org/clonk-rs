+	std::string Serialize(const char *screen, const std::vector<LayoutElement> &elements)
+	{
+		if (elements.empty()) CaptureFailure(std::format("{} layout topology is empty", screen));
+		std::string encoded;
+		for (std::size_t index = 0; index < elements.size(); ++index)
+		{
+			const auto &element = elements[index];
+			if (element.path.empty() || element.role.empty()) CaptureFailure(std::format("{} layout has an empty semantic identity", screen));
+			for (std::size_t previous = 0; previous < index; ++previous)
+				if (elements[previous].path == element.path) CaptureFailure(std::format("{} layout duplicates {}", screen, element.path));
+			if (index) encoded += ',';
+			std::string lines;
+			for (std::size_t lineIndex = 0; lineIndex < element.lines.size(); ++lineIndex)
+			{
+				if (lineIndex) lines += ',';
+				lines += std::format(R"({{"text":"{}","rect":{}}})", ClonkJsonText(element.lines[lineIndex].text), RectJson(element.lines[lineIndex].rect));
+			}
+			encoded += std::format(R"({{"path":"{}","role":"{}","rect":{},"visible":{},{}"caption":"{}","lines":[{}]}})",
+				JsonEscape(element.path), JsonEscape(element.role), RectJson(element.rect), element.visible ? "true" : "false",
+				element.portAsset.empty() ? std::string{} : std::format(R"("port_asset":"{}",)", JsonEscape(element.portAsset)),
+				ClonkJsonText(element.caption), lines);
+		}
+		return std::format(
+			R"({{"schema":"clonk-rs/presentation-layout/v1","screen":"{}","resolution":"{}x{}","scale":{},"elements":[{}]}})",
+			JsonEscape(screen), Config.Graphics.ResX, Config.Graphics.ResY, Config.Graphics.Scale, encoded);
+	}
+
+	bool Intersects(const C4Rect &left, const C4Rect &right)
+	{
+		return left.x < right.x + right.Wdt && right.x < left.x + left.Wdt &&
+			left.y < right.y + right.Hgt && right.y < left.y + left.Hgt;
+	}
