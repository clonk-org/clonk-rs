+std::string C4StartupAboutDlg::BuildPresentationLayoutTrace()
+{
+	// Initial Credits-page topology mirrors C4StartupAboutDlg.cpp:262-301,325-350.
+	if (currentPage != 0 || aboutPages.empty())
+		throw std::runtime_error("startup-about capture requires the initial Credits page");
+	constexpr std::array<const char *, 7> sectionIDs{
+		"game-design", "engine-and-tools", "scripting", "additional-art", "music", "voice", "web"};
+	if (aboutPages[0].size() != sectionIDs.size() * 2)
+		throw std::runtime_error("startup-about Credits topology differs from seven caption/text pairs");
+	const C4Rect background = GetScreenBounds();
+	const int32_t footerHeight = C4GUI::GetRes()->MiniFont.GetLineHeight();
+	const C4Rect footerRect{0, background.Hgt - footerHeight / 2, background.Wdt, footerHeight};
+	const std::string footer = pFanProjectLabel->GetText();
+	std::vector<C4PresentationCapture::LayoutElement> elements;
+	elements.push_back(C4PresentationCapture::Empty("startup/about/background", "image", this));
+	elements.push_back(C4PresentationCapture::Label("startup/about/title", pFullscreenTitle));
+	elements.push_back({"startup/about/branding/fan-project", "label", footerRect, pFanProjectLabel->IsVisible(), "branding", footer, {{footer, footerRect}}});
+	elements.push_back(C4PresentationCapture::Button("startup/about/buttons/back", pBackButton));
+	elements.push_back(C4PresentationCapture::Button("startup/about/buttons/check-updates", pUpdateButton));
+	elements.push_back(C4PresentationCapture::Button("startup/about/buttons/licenses", btnAdvance));
+	for (std::size_t index = 0; index < sectionIDs.size(); ++index)
+	{
+		auto *caption = dynamic_cast<C4GUI::Label *>(aboutPages[0][index * 2]);
+		auto *textWindow = dynamic_cast<C4GUI::TextWindow *>(aboutPages[0][index * 2 + 1]);
+		if (!caption || !textWindow)
+			throw std::runtime_error(std::format("startup-about Credits topology differs at {}", sectionIDs[index]));
+		const std::string base = std::format("startup/about/credits/{}", sectionIDs[index]);
+		elements.push_back(C4PresentationCapture::Label((base + "/caption").c_str(), caption));
+		elements.push_back(C4PresentationCapture::TextWindow((base + "/text").c_str(), textWindow));
+		auto *scrollBar = textWindow->GetPresentationScrollBar();
+		if (!scrollBar)
+			throw std::runtime_error(std::format("startup-about {} text window has no live scrollbar", sectionIDs[index]));
+		elements.push_back(C4PresentationCapture::Empty((base + "/scrollbar").c_str(), "scrollbar", scrollBar));
+	}
+	return C4PresentationCapture::Serialize("startup-about", elements);
+}
