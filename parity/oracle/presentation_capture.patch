+	void PreflightAndPinPresentationRandom()
+	{
+		constexpr std::array expected{9865709, 456730344, 1160337230, 488826203};
+		srand(CaptureSeed);
+		for (const int value : expected)
+			if (rand() != value)
+				CaptureFailure("native libc rand does not match darwin-libc-rand-park-miller-v1 seed-587 preflight");
